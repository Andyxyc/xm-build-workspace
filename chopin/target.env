# Redmi Note 10 Pro CN / chopin / MIUI14 Android13 / Linux 4.14.186.
# No proprietary boot.img uploaded; this compiles source-derived raw candidate only.
CONFIG_ENV=config/chopin.env
KERNEL_SOURCE=https://github.com/ChopinKernels/android_kernel_chopin_android_T.git
KERNEL_SOURCE_BRANCH=T
KERNEL_CONFIG=chopin_user_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=
EXTRA_CMDS:LD=ld.lld STRIP=llvm-strip AS=llvm-as AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://gitlab.com/LeCmnGend/proton-clang.git
CUSTOM_CLANG_BRANCH=clang-13
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
ENABLE_SUSFS=true
SUSFS_REPO=https://github.com/Star-Seven/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=true
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=CONFIG_KSU=y CONFIG_KSU_SUSFS=y CONFIG_KPM=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_KSU_SUSFS_SUS_MAP=n CONFIG_KSU_SUSFS_ENABLE_LOG=n CONFIG_KSU_DEBUG=n CONFIG_KSU_FEATURE_ADBROOT=n CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=false
