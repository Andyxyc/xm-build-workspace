+
+private val CalcBackground=Color(0xFFF7F8FA)
+private val CalcText=Color(0xFF19202B)
+private val CalcMuted=Color(0xFF6B7684)
+private val CalcButton=Color(0xFFE9EEF3)
+private val CalcAccent=Color(0xFF3378ED)
+private val CalcOperator=Color(0xFFDCE8FD)
+
+private object CalcHistory {
+    private const val FILE="local.calc.history.v1"
+    fun read(ctx:Context):List<String> = ctx.getSharedPreferences(FILE,Context.MODE_PRIVATE)
+        .getString("entries","").orEmpty().lines().filter {it.isNotBlank()}.takeLast(40)
+    fun append(ctx:Context,item:String) {
+        val v=(read(ctx)+item.replace('\n',' ').take(90)).takeLast(40)
+        ctx.getSharedPreferences(FILE,Context.MODE_PRIVATE).edit().putString("entries",v.joinToString("\n")).apply()
+    }
+    fun clear(ctx:Context) {ctx.getSharedPreferences(FILE,Context.MODE_PRIVATE).edit().remove("entries").apply()}
+}
+
+@Composable
+internal fun MokCalculatorApp(onUnlock:(String)->Unit) {
+    val ctx=LocalContext.current
+    var display by remember { mutableStateOf("0") }
+    var formula by remember { mutableStateOf("") }
+    var stored by remember { mutableStateOf<BigDecimal?>(null) }
+    var op by remember { mutableStateOf("") }
+    var fresh by remember { mutableStateOf(true) }
+    var sci by remember { mutableStateOf(false) }
+    var memory by remember { mutableStateOf<BigDecimal?>(null) }
+    var showHistory by remember { mutableStateOf(false) }
+    var historyRev by remember { mutableIntStateOf(0) }
+    val secret=MokDisguise.calculatorUnlock(ctx)
+    val pinSize=MokDisguise.pinLength(ctx)
+
+    fun maybeRestore(trigger:String):Boolean {
+        if(trigger!=secret || op.isNotEmpty() || stored!=null || display.length!=pinSize ||
+            display.any {it !in '0'..'9'}) return false
+        onUnlock(display)
+        return true
+    }
+    fun calculate():String {
+        val left=stored ?: return display
+        val right=display.toBigDecimalOrNull() ?: return display
+        return runCatching {
+            (when(op) {
+                "+" -> left.add(right)
+                "−" -> left.subtract(right)
+                "×" -> left.multiply(right)
+                "÷" -> if(right.compareTo(BigDecimal.ZERO)==0) throw ArithmeticException() else left.divide(right,MathContext.DECIMAL64)
+                else -> right
+            }).stripTrailingZeros().toPlainString().take(26)
+        }.getOrDefault("无法计算")
+    }
+    fun process(symbol:String) {
+        when(symbol) {
+            "AC" -> {display="0";formula="";stored=null;op="";fresh=true}
+            "⌫" -> {display=display.dropLast(1).ifBlank {"0"};fresh=false}
+            "±" -> {if(display!="0" && display!="无法计算") display=if(display.startsWith("-"))display.drop(1) else "-$display"}
+            "%" -> if(!maybeRestore("percent")) {
+                display=runCatching {display.toBigDecimal().movePointLeft(2).stripTrailingZeros().toPlainString()}.getOrDefault(display)
+            }
+            "÷","×","−","+" -> {
+                stored=display.toBigDecimalOrNull()
+                op=symbol;formula="$display $symbol";fresh=true
+            }
+            "=" -> {
+                if(maybeRestore("equals")) return
+                if(op.isNotBlank() && stored!=null) {
+                    val old="${stored!!.stripTrailingZeros().toPlainString()} $op $display"
+                    display=calculate()
+                    formula="$old ="
+                    if(display!="无法计算") {CalcHistory.append(ctx,"$old = $display");historyRev++}
+                }
+                stored=null;op="";fresh=true
+            }
+            "π" -> {display=Math.PI.toString().take(17);fresh=true}
+            "e" -> {display=Math.E.toString().take(17);fresh=true}
+            "√","sin","cos","tan","ln","x²","1/x" -> {
+                val n=display.toDoubleOrNull() ?: return
+                val v=when(symbol) {
+                    "√" -> sqrt(n);"sin" -> sin(Math.toRadians(n));"cos" -> cos(Math.toRadians(n))
+                    "tan" -> tan(Math.toRadians(n));"ln" -> ln(n);"x²" -> n*n;else -> 1.0/n
+                }
+                display=if(v.isFinite()) BigDecimal(v,MathContext(12,RoundingMode.HALF_UP)).stripTrailingZeros().toPlainString() else "无法计算"
+                formula="$symbol($n)";fresh=true
+            }
+            "." -> {
+                if (fresh) {display="0.";fresh=false}
+                else if(!display.contains('.')) display+="."
+            }
+            else -> if(symbol.matches(Regex("[0-9]"))) {
+                display=if(fresh || display=="0" || display=="无法计算")symbol
+                        else if(display.length<23)display+symbol else display
+                fresh=false
+            }
+        }
+    }
+    MaterialTheme(colorScheme=lightColorScheme(primary=CalcAccent,onPrimary=Color.White,
+        background=CalcBackground,onBackground=CalcText,surface=CalcBackground,onSurface=CalcText)) {
+        Surface(Modifier.fillMaxSize(),color=CalcBackground) {
+            BoxWithConstraints(Modifier.fillMaxSize()) {
+                val compact=maxHeight<670.dp
+                val keyHeight=if(compact)54.dp else 68.dp
+                val gap=if(compact)4.dp else 7.dp
+                val numberSize=if(maxWidth<350.dp)24.sp else 29.sp
+                Column(Modifier.fillMaxSize().padding(horizontal=18.dp,vertical=12.dp)) {
+                    Row(Modifier.fillMaxWidth().height(46.dp),verticalAlignment=Alignment.CenterVertically,
+                        horizontalArrangement=Arrangement.SpaceBetween) {
+                        Text("计算器",fontSize=24.sp,fontWeight=FontWeight.SemiBold,color=CalcText)
+                        Row(horizontalArrangement=Arrangement.spacedBy(4.dp),verticalAlignment=Alignment.CenterVertically) {
+                            TextButton(onClick={sci=!sci}) {Text(if(sci)"基础" else "科学",color=CalcMuted)}
+                            TextButton(onClick={
+                                if(!maybeRestore("history"))showHistory=true
+                            }) {Text("历史",color=CalcMuted)}
+                        }
+                    }
+                    Spacer(Modifier.weight(1f))
+                    Text(formula,Modifier.fillMaxWidth().padding(horizontal=6.dp,vertical=8.dp),
+                        fontSize=15.sp,color=CalcMuted,textAlign=TextAlign.End,maxLines=1)
+                    Text(display,Modifier.fillMaxWidth().padding(horizontal=6.dp,vertical=10.dp),
+                        fontSize=if(maxWidth<350.dp)40.sp else 49.sp,
+                        fontWeight=FontWeight.Light,color=CalcText,textAlign=TextAlign.End,maxLines=1)
+                    if(sci) {
+                        Row(Modifier.fillMaxWidth().padding(bottom=7.dp),horizontalArrangement=Arrangement.spacedBy(5.dp)) {
+                            listOf("√","sin","cos","tan","ln","x²","1/x","π","e").take(5).forEach { label ->
+                                TextButton(onClick={process(label)},modifier=Modifier.weight(1f),
+                                    contentPadding=PaddingValues(0.dp)) {
+                                    Text(label,fontSize=if(compact)12.sp else 14.sp,color=CalcAccent,maxLines=1)
+                                }
+                            }
+                        }
+                        Row(Modifier.fillMaxWidth().padding(bottom=7.dp),horizontalArrangement=Arrangement.spacedBy(5.dp)) {
+                            listOf("x²","1/x","π","e","MR").forEach { label ->
+                                TextButton(onClick={if(label=="MR")display=memory?.stripTrailingZeros()?.toPlainString()?:display else process(label)},
+                                    modifier=Modifier.weight(1f),contentPadding=PaddingValues(0.dp)) {
+                                    Text(label,fontSize=if(compact)12.sp else 14.sp,color=CalcAccent,maxLines=1)
+                                }
+                            }
+                        }
+                    }
+                    val rows=listOf(listOf("AC","±","%","÷"),listOf("7","8","9","×"),
+                        listOf("4","5","6","−"),listOf("1","2","3","+"),listOf("⌫","0",".","="))
+                    rows.forEach { row ->
+                        Row(Modifier.fillMaxWidth().padding(vertical=gap),horizontalArrangement=Arrangement.spacedBy(8.dp)) {
+                            row.forEach { symbol ->
+                                val bg=when(symbol) {"="->CalcAccent;"÷","×","−","+"->CalcOperator;else->CalcButton}
+                                Button(onClick={process(symbol)},modifier=Modifier.weight(1f).height(keyHeight),
+                                    contentPadding=PaddingValues(0.dp),shape=RoundedCornerShape(20.dp),
+                                    colors=ButtonDefaults.buttonColors(containerColor=bg,
+                                        contentColor=if(symbol=="=")Color.White else CalcText),
+                                    elevation=null) {
+                                    Text(symbol,fontSize=numberSize,fontWeight=FontWeight.Normal,maxLines=1)
+                                }
+                            }
+                        }
+                    }
+                    if(!compact) {
+                        Row(Modifier.fillMaxWidth().padding(top=6.dp),horizontalArrangement=Arrangement.End) {
+                            TextButton(onClick={memory=display.toBigDecimalOrNull()}){Text("M+",color=CalcMuted)}
+                            TextButton(onClick={memory=null}){Text("MC",color=CalcMuted)}
+                        }
+                    }
+                }
+            }
+        }
+        if(showHistory) {
+            val items=remember(showHistory,historyRev) {CalcHistory.read(ctx)}
+            AlertDialog(onDismissRequest={showHistory=false},title={Text("计算历史")},
+                text={Column(Modifier.fillMaxWidth().heightIn(max=380.dp).verticalScroll(rememberScrollState())) {
+                    if(items.isEmpty())Text("暂无计算记录",color=CalcMuted)
+                    items.reversed().forEach { value ->
+                        Text(value,modifier=Modifier.fillMaxWidth().clickable {
+                            display=value.substringAfterLast(" = ");showHistory=false
+                        }.padding(vertical=12.dp),fontSize=15.sp)
+                    }
+                }},confirmButton={TextButton(onClick={showHistory=false}){Text("关闭")}},
+                dismissButton={TextButton(onClick={CalcHistory.clear(ctx);historyRev++;showHistory=false}){Text("清空")}})
+        }
+    }
+}
