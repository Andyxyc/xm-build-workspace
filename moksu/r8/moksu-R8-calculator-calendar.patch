+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+import android.Manifest
+import android.app.AlarmManager
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.provider.CalendarContract
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import me.weishu.kernelsu.R
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.LocalDate
+import java.time.LocalTime
+import java.time.YearMonth
+import java.time.ZoneId
+import java.util.UUID
+
+internal data class AgendaEvent(
+    val id:String,
+    val date:String,
+    val title:String,
+    val time:String="",
+    val note:String="",
+    val repeat:String="none",
+    val minutes:Int=-1,
+    val allDay:Boolean=false,
+    val place:String=""
+)
+
+internal object MokAgenda {
+    private const val PREF="moksu.local.calendar.v1"
+    private const val KEY="entries"
+    fun read(ctx:Context):List<AgendaEvent> = runCatching {
+        val input=JSONArray(ctx.getSharedPreferences(PREF,Context.MODE_PRIVATE).getString(KEY,"[]") ?: "[]")
+        (0 until minOf(1000,input.length())).mapNotNull { i ->
+            val o=input.optJSONObject(i) ?: return@mapNotNull null
+            val date=o.optString("date")
+            val title=o.optString("title")
+            if(runCatching{LocalDate.parse(date)}.isFailure || title.isBlank()) null
+            else AgendaEvent(o.optString("id").ifBlank{UUID.randomUUID().toString()},date,
+                title.take(90),o.optString("time").take(5),o.optString("note").take(360),
+                o.optString("repeat","none").takeIf {it in setOf("none","daily","weekly","monthly")}?:"none",
+                o.optInt("minutes",-1),o.optBoolean("allDay",false),o.optString("place").take(90))
+        }
+    }.getOrDefault(emptyList())
+    private fun save(ctx:Context,entries:List<AgendaEvent>):Boolean {
+        val out=JSONArray()
+        entries.take(1000).forEach { e->out.put(JSONObject()
+            .put("id",e.id).put("date",e.date).put("title",e.title).put("time",e.time)
+            .put("note",e.note).put("repeat",e.repeat).put("minutes",e.minutes)
+            .put("allDay",e.allDay).put("place",e.place)) }
+        return ctx.getSharedPreferences(PREF,Context.MODE_PRIVATE).edit().putString(KEY,out.toString()).commit()
+    }
+    fun put(ctx:Context,event:AgendaEvent):Boolean {
+        val list=read(ctx).toMutableList()
+        if(event.title.isBlank() || event.title.length>90 || event.note.length>360)return false
+        val existing=list.indexOfFirst{it.id==event.id}
+        if(existing>=0)list[existing]=event
+        else {if(list.size>=1000)return false;list.add(event)}
+        if(!save(ctx,list))return false
+        MokAgendaReminders.cancel(ctx,event.id)
+        MokAgendaReminders.schedule(ctx,event)
+        return true
+    }
+    fun remove(ctx:Context,id:String):Boolean {
+        val original=read(ctx)
+        val updated=original.filterNot{it.id==id}
+        if(original.size==updated.size)return false
+        if(!save(ctx,updated))return false
+        MokAgendaReminders.cancel(ctx,id)
+        return true
+    }
+    fun onDay(event:AgendaEvent, day:LocalDate):Boolean = runCatching {
+        val start=LocalDate.parse(event.date)
+        if(day.isBefore(start))return@runCatching false
+        when(event.repeat) {
+            "daily" -> true
+            "weekly" -> day.dayOfWeek==start.dayOfWeek
+            "monthly" -> day.dayOfMonth==start.dayOfMonth
+            else -> day==start
+        }
+    }.getOrDefault(false)
+    fun days(ctx:Context,day:LocalDate):List<AgendaEvent> = read(ctx).filter{onDay(it,day)}.sortedBy{it.time}
+}
+
+/** Local reminders only; non-exact alarms avoid privileged exact-alarm permission. */
+internal object MokAgendaReminders {
+    private const val CHANNEL="calendar_reminders_v1"
+    private const val ACTION="me.weishu.kernelsu.mok.LOCAL_REMINDER"
+    private fun intent(ctx:Context,id:String):PendingIntent = PendingIntent.getBroadcast(ctx,id.hashCode(),
+        Intent(ctx,MokAgendaReminderReceiver::class.java).setAction(ACTION).putExtra("event_id",id),
+        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+    fun cancel(ctx:Context,id:String) { (ctx.getSystemService(Context.ALARM_SERVICE) as? AlarmManager)
+        ?.cancel(intent(ctx,id)) }
+    private fun nextMillis(e:AgendaEvent,after:Long):Long? {
+        if(e.minutes<0)return null
+        val date=runCatching{LocalDate.parse(e.date)}.getOrNull()?:return null
+        val time=runCatching{LocalTime.parse(e.time)}.getOrDefault(LocalTime.of(9,0))
+        val now=LocalDate.now().minusDays(1)
+        for(dayOffset in 0..366) {
+            val day=now.plusDays(dayOffset.toLong())
+            if(day.isBefore(date)||!MokAgenda.onDay(e,day))continue
+            val timestamp=day.atTime(time).atZone(ZoneId.systemDefault()).toInstant().toEpochMilli()-e.minutes*60_000L
+            if(timestamp>after+5_000L)return timestamp
+        }
+        return null
+    }
+    fun schedule(ctx:Context,e:AgendaEvent) {
+        val trigger=nextMillis(e,System.currentTimeMillis())?:return
+        runCatching {
+            (ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager)
+                .setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP,trigger,intent(ctx,e.id))
+        }
+    }
+    fun restore(ctx:Context) {MokAgenda.read(ctx).forEach{schedule(ctx,it)}}
+    fun notify(ctx:Context,e:AgendaEvent) {
+        if(Build.VERSION.SDK_INT>=33 && ContextCompat.checkSelfPermission(ctx,Manifest.permission.POST_NOTIFICATIONS)!=PackageManager.PERMISSION_GRANTED)return
+        val mgr=ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        mgr.createNotificationChannel(NotificationChannel(CHANNEL,"日历提醒",NotificationManager.IMPORTANCE_DEFAULT))
+        val open=PendingIntent.getActivity(ctx,e.id.hashCode(),Intent(ctx,MokDisguiseActivity::class.java),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+        val notification=NotificationCompat.Builder(ctx,CHANNEL)
+            .setSmallIcon(R.drawable.mok_calendar_icon)
+            .setContentTitle(e.title).setContentText(e.place.ifBlank{e.note.ifBlank{e.time}})
+            .setStyle(NotificationCompat.BigTextStyle().bigText(e.note.ifBlank {e.place}))
+            .setContentIntent(open).setAutoCancel(true).setPriority(NotificationCompat.PRIORITY_DEFAULT).build()
+        mgr.notify(e.id.hashCode(),notification)
+    }
+    fun isReminderAction(action:String?)=action==ACTION
+}
+
+class MokAgendaReminderReceiver:BroadcastReceiver() {
+    override fun onReceive(ctx:Context,intent:Intent) {
+        if(intent.action==Intent.ACTION_BOOT_COMPLETED || intent.action==Intent.ACTION_TIME_CHANGED ||
+            intent.action==Intent.ACTION_TIMEZONE_CHANGED) {
+            MokAgendaReminders.restore(ctx);return
+        }
+        if(!MokAgendaReminders.isReminderAction(intent.action))return
+        val id=intent.getStringExtra("event_id")?:return
+        val event=MokAgenda.read(ctx).find{it.id==id}?:return
+        MokAgendaReminders.notify(ctx,event)
+        MokAgendaReminders.schedule(ctx,event)
+    }
+}
+
+/** Read-only import, only after the user grants READ_CALENDAR; no automatic account sync. */
+internal fun systemCalendarEvents(ctx:Context,month:YearMonth):List<AgendaEvent> {
+    if(ContextCompat.checkSelfPermission(ctx,Manifest.permission.READ_CALENDAR)!=PackageManager.PERMISSION_GRANTED)return emptyList()
+    return runCatching {
+        val begin=month.atDay(1).atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli()
+        val end=month.plusMonths(1).atDay(1).atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli()
+        val uri=CalendarContract.Instances.CONTENT_URI.buildUpon()
+        android.content.ContentUris.appendId(uri,begin);android.content.ContentUris.appendId(uri,end)
+        val out=mutableListOf<AgendaEvent>()
+        ctx.contentResolver.query(uri.build(),arrayOf(CalendarContract.Instances.TITLE,
+            CalendarContract.Instances.BEGIN,CalendarContract.Instances.EVENT_LOCATION),null,null,null)?.use { cur->
+            while(cur.moveToNext()&&out.size<300) {
+                val timestamp=cur.getLong(1)
+                val zoned=java.time.Instant.ofEpochMilli(timestamp).atZone(ZoneId.systemDefault())
+                out.add(AgendaEvent("external-${timestamp}-${out.size}",zoned.toLocalDate().toString(),
+                    cur.getString(0)?:"日程",zoned.toLocalTime().toString().take(5),
+                    place=cur.getString(2).orEmpty()))
+            }
+        }
+        out
+    }.getOrDefault(emptyList())
+}
