+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+import java.net.HttpURLConnection
+import java.net.URL
+import me.weishu.kernelsu.ui.util.WebAdminCli
+import org.json.JSONObject
+
+/** Password gate is checked in MokDisguiseActivity before this local-only recovery path. */
+internal object MokWebRecovery {
+    private val safe = Regex("^http://127\\.0\\.0\\.1:[0-9]{1,5}/x7k9f/[0-9a-fA-F]{64}$")
+
+    fun disableStealth(): Boolean = runCatching {
+        val base = WebAdminCli.url().trim()
+        if (!safe.matches(base)) return false
+        val url = URL("$base/api/stealth")
+        val conn = url.openConnection() as HttpURLConnection
+        try {
+            conn.requestMethod = "POST"
+            conn.connectTimeout = 2000
+            conn.readTimeout = 3000
+            conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded; charset=utf-8")
+            conn.useCaches = false
+            conn.doOutput = true
+            conn.outputStream.use { it.write("enable=0".toByteArray(Charsets.UTF_8)) }
+            conn.responseCode == 200 && JSONObject(conn.inputStream.bufferedReader().use { it.readText() })
+                .optBoolean("ok", false)
+        } finally { conn.disconnect() }
+    }.getOrDefault(false)
+}
