+/** Offline local agenda: stored in the application's private preferences, with no calendar permission. */
+private data class LocalAgenda(val id:String,val date:String,val title:String,val time:String)
+private object LocalAgendaStore {
+    private const val PREF="moksu.local.calendar.v1"
+    private const val KEY="entries"
+    fun read(context:Context): List<LocalAgenda> = runCatching {
+        val input=JSONArray(context.getSharedPreferences(PREF,Context.MODE_PRIVATE).getString(KEY,"[]") ?: "[]")
+        (0 until minOf(600,input.length())).mapNotNull { index ->
+            val o=input.optJSONObject(index) ?: return@mapNotNull null
+            val date=o.optString("date")
+            val title=o.optString("title")
+            if (!date.matches(Regex("[0-9]{4}-[0-9]{2}-[0-9]{2}")) || title.isBlank()) null
+            else LocalAgenda(o.optString("id"),date,title.take(80),o.optString("time").take(5))
+        }
+    }.getOrDefault(emptyList())
+    private fun save(context:Context, entries:List<LocalAgenda>):Boolean {
+        val array=JSONArray()
+        entries.take(600).forEach { e ->
+            array.put(JSONObject().put("id",e.id).put("date",e.date).put("title",e.title).put("time",e.time))
+        }
+        return context.getSharedPreferences(PREF,Context.MODE_PRIVATE).edit()
+            .putString(KEY,array.toString()).commit()
+    }
+    fun add(context:Context,date:LocalDate,title:String,time:String):Boolean {
+        if(title.isBlank() || title.length>80 || read(context).size>=600) return false
+        return save(context, read(context)+LocalAgenda(UUID.randomUUID().toString(),date.toString(),title.trim(),time))
+    }
+    fun remove(context:Context,id:String):Boolean=save(context,read(context).filterNot { it.id==id })
+}
