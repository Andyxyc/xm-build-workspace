--- /dev/null
+++ b/manager/app/src/main/java/me/weishu/kernelsu/mok/MokStealthRecovery.kt
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+import android.content.Context
+import android.os.UserManager
+import android.util.Log
+import me.weishu.kernelsu.Natives
+
+/**
+ * R7.7 one-time migration for stale /data/adb/sevenk/stealth=1.
+ * A flashed boot image does not clear userdata, so the old flag survives.
+ * This must alter the REAL kernel state via the signed manager ioctl;
+ * changing the screen alone would leave the device hidden.
+ *
+ * Local consent is deliberately stored in an Android backup-excluded preference.
+ * Old R7.6's presentation mirror is NOT a consent marker: it was written by reads.
+ * We only reconcile legacy state once, then preserve explicit future choices.
+ */
+internal object MokStealthRecovery {
+    private const val TAG = "moksu-stealth-recovery"
+    private const val PREF = "moksu.stealth.recovery.v1"
+    private const val DONE = "r77_legacy_migration_completed"
+    private const val OPT_IN = "explicit_enable_on_this_device"
+    @Volatile private var inProgress = false
+
+    private fun prefs(context: Context) =
+        context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+
+    @Synchronized fun reconcileOnce(context: Context) {
+        if (inProgress) return
+        val unlocked = runCatching {
+            context.getSystemService(UserManager::class.java)?.isUserUnlocked ?: false
+        }.getOrDefault(false)
+        if (!unlocked) return
+        val local = prefs(context)
+        if (local.getBoolean(DONE, false)) return
+        inProgress = true
+        try {
+            val kernel = runCatching { Natives.stealthState() }.getOrDefault(-1)
+            val action = MokStealthRecoveryPolicy.decide(
+                kernelState = kernel,
+                migrationCompleted = local.getBoolean(DONE, false),
+                deliberateEnableOnThisDevice = local.getBoolean(OPT_IN, false),
+                launcherMode = MokDisguise.mode(context),
+            )
+            when (action) {
+                MokStealthRecoveryPolicy.Action.RETRY_LATER,
+                MokStealthRecoveryPolicy.Action.NO_CHANGE -> Unit
+                MokStealthRecoveryPolicy.Action.REMEMBER -> {
+                    if (!local.edit().putBoolean(DONE, true).commit())
+                        Log.w(TAG, "Unable to save migration state")
+                }
+                MokStealthRecoveryPolicy.Action.CLEAR_LEGACY_ONCE -> {
+                    // manager_or_root permits the trusted manager UID even if
+                    // GET_INFO deliberately hides the MANAGER bit. No su grant.
+                    val restored = runCatching {
+                        Natives.stealthSet(false) && Natives.stealthState() == 0
+                    }.getOrDefault(false)
+                    if (!restored) {
+                        // Never lie about kernel state or suppress the existing UI.
+                        Log.w(TAG, "Legacy kernel hidden state could not be cleared")
+                        return
+                    }
+                    if (!local.edit().putBoolean(DONE, true).commit())
+                        Log.w(TAG, "Kernel restored but migration receipt not saved")
+                }
+            }
+        } finally { inProgress = false }
+    }
+
+    /** Write intent *before* enabling stealth so a process crash cannot hide it. */
+    @Synchronized fun prepareExplicitEnable(context: Context): Boolean =
+        prefs(context).edit().putBoolean(OPT_IN, true).putBoolean(DONE, true).commit()
+
+    /** Called only after a confirmed ioctl readback. */
+    @Synchronized fun onExplicitResult(context: Context, enabled: Boolean, success: Boolean) {
+        // Failed disable must NOT erase proof of an intentionally hidden device.
+        if (!success && !enabled) return
+        val editor = prefs(context).edit()
+        if (success) {
+            editor.putBoolean(DONE, true)
+            if (enabled) editor.putBoolean(OPT_IN, true) else editor.remove(OPT_IN)
+        } else {
+            // The original state was off; a failed enable must not leave consent.
+            editor.remove(OPT_IN)
+        }
+        if (!editor.commit()) Log.w(TAG, "Could not persist explicit stealth choice")
+    }
+}
