@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+/** Only first-run migration may clear a legacy kernel flag.
+ * An unknown response is NOT proof of an installed or hidden kernel.
+ * A subsequent deliberate opt-in must survive reboot and app relaunch.
+ */
+internal object MokStealthRecoveryPolicy {
+    enum class Action { RETRY_LATER, REMEMBER, CLEAR_LEGACY_ONCE, NO_CHANGE }
+
+    fun decide(
+        kernelState: Int,
+        migrationCompleted: Boolean,
+        deliberateEnableOnThisDevice: Boolean,
+        launcherMode: String,
+    ): Action = when {
+        migrationCompleted -> Action.NO_CHANGE
+        kernelState !in 0..1 -> Action.RETRY_LATER
+        kernelState == 0 -> Action.REMEMBER
+        deliberateEnableOnThisDevice -> Action.REMEMBER
+        launcherMode != "normal" -> Action.REMEMBER
+        else -> Action.CLEAR_LEGACY_ONCE
+    }
+}
