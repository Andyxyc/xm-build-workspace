+/** Kernel stealth is the authority, not a migrated application preference.
+ * Reboot/phone migration must not reuse an older device's local hidden flag.
+ * A volatile observation protects an already-hidden session against a brief
+ * kernel ioctl read failure, without surviving process death or device change.
+ */
 internal object MokDisplayState {
     private const val PREF = "moksu.presentation.v1"
     private const val KEY = "uninstalled_ui"
     private fun actual(): Int = runCatching { Natives.stealthState() }.getOrDefault(-1)
+    @Volatile private var lastVerifiedInProcess = -1
 
     fun showUninstalled(context: Context): Boolean {
