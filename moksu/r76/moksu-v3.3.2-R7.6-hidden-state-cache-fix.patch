-            else -> prefs.getBoolean(KEY,false) // last verified state, fail closed in UI
+        val state = actual()
+        if (state == 0 || state == 1) {
+            lastVerifiedInProcess = state
+            val prefs = context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+            val enabled = state == 1
+            if (prefs.getBoolean(KEY, false) != enabled) {
+                prefs.edit().putBoolean(KEY, enabled).apply()
+            }
+            return enabled
         }
+        // Unknown is never allowed to promote a restored preference into
+        // hidden mode. Only a kernel state verified in this process may persist.
+        return lastVerifiedInProcess == 1
     }
 
