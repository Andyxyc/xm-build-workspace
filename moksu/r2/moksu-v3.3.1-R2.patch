+/// Secret-bearing Root grant policies and APK metadata must never share the public webpage assets.
+/// All paths are derived from the already protected webadmin.conf location.
+fn grant_rules_path() -> String { format!("{}.grant-rules.json", config_path()) }
+fn app_metadata_path() -> String { format!("{}.app-metadata.json", config_path()) }
+
+fn valid_cert_sha256(s: &str) -> bool {
+    s.len() == 64 && s.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+fn private_write(path: &str, bytes: &[u8]) -> std::io::Result<()> {
+    use std::io::Write as _;
+    let dest = std::path::Path::new(path);
+    if let Some(parent) = dest.parent() { std::fs::create_dir_all(parent)?; }
+    let tmp = format!("{path}.tmp-{}-{}",std::process::id(),
+        random_hex(12).ok_or_else(|| std::io::Error::other("secure random unavailable"))?);
+    let result = (|| -> std::io::Result<()> {
+        let mut f = std::fs::OpenOptions::new().write(true).create_new(true).open(&tmp)?;
+        #[cfg(unix)] {
+            use std::os::unix::fs::PermissionsExt;
+            f.set_permissions(std::fs::Permissions::from_mode(0o600))?;
+        }
+        f.write_all(bytes)?;
+        f.sync_all()?;
+        std::fs::rename(&tmp, path)?;
+        Ok(())
+    })();
+    if result.is_err() { let _ = std::fs::remove_file(&tmp); }
+    result
+}
+
+fn load_grant_rules() -> std::collections::BTreeMap<String,String> {
+    let text = std::fs::read_to_string(grant_rules_path()).unwrap_or_default();
+    let raw: std::collections::BTreeMap<String,String> =
+        serde_json::from_str(&text).unwrap_or_default();
+    raw.into_iter().filter(|(k,v)| valid_pkg(k) && valid_cert_sha256(v)).take(128).collect()
+}
+fn save_grant_rules(rules: &std::collections::BTreeMap<String,String>) -> std::io::Result<()> {
+    let text = serde_json::to_vec(rules).map_err(std::io::Error::other)?;
+    private_write(&grant_rules_path(), &text)
+}
+
+pub fn load_app_metadata() -> std::collections::BTreeMap<String,serde_json::Value> {
+    let text = std::fs::read_to_string(app_metadata_path()).unwrap_or_default();
+    let raw: std::collections::BTreeMap<String,serde_json::Value> =
+        serde_json::from_str(&text).unwrap_or_default();
+    raw.into_iter().filter(|(pkg,v)| valid_pkg(pkg) && v.is_object()).take(5000).collect()
+}
+fn update_app_metadata(raw: &str) -> Result<usize,String> {
+    let incoming: Vec<serde_json::Value> = serde_json::from_str(raw).map_err(|_|"无效 JSON")?;
+    if incoming.len() > 16 { return Err("一次最多同步 16 个应用".into()); }
+    let mut meta = load_app_metadata();
+    let mut count = 0;
+    for item in incoming {
+        let pkg = item.get("pkg").and_then(serde_json::Value::as_str).unwrap_or("");
+        let label = item.get("label").and_then(serde_json::Value::as_str).unwrap_or("");
+        let icon = item.get("icon").and_then(serde_json::Value::as_str).unwrap_or("");
+        let sig = item.get("sha256").and_then(serde_json::Value::as_str).unwrap_or("");
+        if !valid_pkg(pkg) || label.is_empty() || label.chars().count() > 100
+            || (!sig.is_empty() && !valid_cert_sha256(sig))
+            || icon.len() > 16000
+            || (!icon.is_empty() && (!icon.starts_with("data:image/png;base64,")
+                || !icon[22..].bytes().all(|c| c.is_ascii_alphanumeric() || c == b'+' || c == b'/' || c == b'='))) {
+            continue;
+        }
+        meta.insert(pkg.to_string(), serde_json::json!({"label":label,"icon":icon,"sha256":sig}));
+        count += 1;
+    }
+    if meta.len() > 5000 { return Err("应用缓存超出上限".into()); }
+    let bytes = serde_json::to_vec(&meta).map_err(|e|e.to_string())?;
+    if bytes.len() > 24*1024*1024 { return Err("应用缓存过大".into()); }
+    private_write(&app_metadata_path(),&bytes).map_err(|e|e.to_string())?;
+    Ok(count)
+}
