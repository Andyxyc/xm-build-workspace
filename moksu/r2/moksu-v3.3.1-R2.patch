+package me.weishu.kernelsu.mok
+
+import android.accessibilityservice.AccessibilityService
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.os.Build
+import android.os.SystemClock
+import android.util.Base64
+import android.util.Log
+import android.view.accessibility.AccessibilityEvent
+import me.weishu.kernelsu.Natives
+import me.weishu.kernelsu.ui.MainActivity
+import me.weishu.kernelsu.ui.util.WebAdminCli
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.ByteArrayOutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.nio.charset.StandardCharsets
+import java.security.MessageDigest
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** The Android framework is the source of actual app labels, signing certs and icons.
+ * The local ksud panel never contacts the internet or stores the access token in prefs/logs.
+ */
+internal object MokWebDeviceBridge {
+    private val running = AtomicBoolean(false)
+    @Volatile private var lastSync = 0L
+    private val localUrl = Regex("^http://127\\.0\\.0\\.1:[0-9]{1,5}/x7k9f/[0-9a-fA-F]{64}$")
+    private fun baseUrl(): String? = WebAdminCli.url().trim().takeIf { localUrl.matches(it) }
+
+    private fun request(base: String, path: String, body: Map<String,String>? = null): JSONObject {
+        require(localUrl.matches(base))
+        val conn = (URL(base + path).openConnection() as HttpURLConnection)
+        try {
+            conn.connectTimeout = 1800
+            conn.readTimeout = 3000
+            conn.useCaches = false
+            if (body != null) {
+                conn.requestMethod = "POST"
+                conn.doOutput = true
+                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded; charset=utf-8")
+                val data = body.entries.joinToString("&") {
+                    URLEncoder.encode(it.key, "UTF-8") + "=" + URLEncoder.encode(it.value, "UTF-8")
+                }
+                conn.outputStream.use { it.write(data.toByteArray(StandardCharsets.UTF_8)) }
+            }
+            if (conn.responseCode != 200) return JSONObject()
+            return JSONObject(conn.inputStream.bufferedReader().use { it.readText() })
+        } finally { conn.disconnect() }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun certificateSha(pm: PackageManager, name: String): String {
+        return runCatching {
+            val p: PackageInfo = if (Build.VERSION.SDK_INT >= 28)
+                pm.getPackageInfo(name, PackageManager.GET_SIGNING_CERTIFICATES)
+            else pm.getPackageInfo(name, PackageManager.GET_SIGNATURES)
+            val certs = if (Build.VERSION.SDK_INT >= 28)
+                p.signingInfo?.apkContentsSigners
+            else p.signatures
+            if (certs?.size != 1) return "" // reject ambiguous multiple signers
+            val bytes = MessageDigest.getInstance("SHA-256").digest(certs[0].toByteArray())
+            bytes.joinToString("") { "%02x".format(it.toInt() and 255) }
+        }.getOrDefault("")
+    }
+
+    private fun iconBase64(pm: PackageManager, pkg: String): String = runCatching {
+        val drawable = pm.getApplicationIcon(pkg)
+        val image = Bitmap.createBitmap(42, 42, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(image)
+        drawable.setBounds(0, 0, 42, 42)
+        drawable.draw(canvas)
+        val bytes = ByteArrayOutputStream().use { out ->
+            image.compress(Bitmap.CompressFormat.PNG, 100, out)
+            out.toByteArray()
+        }
+        image.recycle()
+        if (bytes.size > 7500) "" else "data:image/png;base64," + Base64.encodeToString(bytes, Base64.NO_WRAP)
+    }.getOrDefault("")
+
+    private fun record(pm: PackageManager, pkg: String): JSONObject? = runCatching {
+        val app = pm.getApplicationInfo(pkg, 0)
+        val label = app.loadLabel(pm)?.toString()?.trim().orEmpty().take(100).ifBlank { pkg }
+        JSONObject().put("pkg",pkg).put("label",label)
+            .put("icon",iconBase64(pm,pkg)).put("sha256",certificateSha(pm,pkg))
+    }.getOrNull()
+
+    fun syncAsync(context: Context) {
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastSync < 120_000 || !running.compareAndSet(false,true)) return
+        val app = context.applicationContext
+        Thread({
+            try {
+                val base = baseUrl() ?: return@Thread
+                val pm = app.packageManager
+                @Suppress("DEPRECATION")
+                val infos = pm.getInstalledPackages(0)
+                // Server enforces 16 entries and 64 KiB body; use small chunks.
+                infos.chunked(5).forEach { chunk ->
+                    val array = JSONArray()
+                    chunk.forEach { p -> record(pm,p.packageName)?.let { array.put(it) } }
+                    if (array.length() > 0) request(base,"/api/app/metadata",mapOf("data" to array.toString()))
+                }
+                lastSync = SystemClock.elapsedRealtime()
+            } catch (e: Exception) {
+                Log.w("moksu", "应用资料同步暂不可用: ${e.javaClass.simpleName}")
+            } finally { running.set(false) }
+        }, "moksu-app-meta").start()
+    }
+
+    fun applyPackageRule(context: Context, pkg: String) {
+        if (!pkg.matches(Regex("[A-Za-z][A-Za-z0-9_.]{1,199}"))) return
+        val base = baseUrl() ?: return
+        val pm = context.packageManager
+        val sha = certificateSha(pm,pkg)
+        if (sha.length != 64) return
+        val rules = request(base, "/api/grant-rules").optJSONArray("list") ?: return
+        var allowed = false
+        for (i in 0 until rules.length()) {
+            val item = rules.optJSONObject(i) ?: continue
+            if (item.optString("pkg") == pkg && item.optString("sha256") == sha) { allowed = true; break }
+        }
+        if (!allowed) return
+        val uid = runCatching { pm.getApplicationInfo(pkg,0).uid }.getOrDefault(-1)
+        if (uid < 2000) return
+        val result = request(base,"/api/grant-rules/apply",mapOf("pkg" to pkg,"uid" to uid.toString(),"sig" to sha))
+        if (!result.optBoolean("ok")) Log.w("moksu", "固定授权内核回读失败（不含密钥），包：$pkg")
+    }
+
+    fun configAutoOpen(): Pair<Boolean,String>? = runCatching {
+        val base = baseUrl() ?: return null
+        request(base,"/api/browser/auto").optBoolean("enabled",false) to base
+    }.getOrNull()
+
+    fun dialToggle(context: Context, supplied: String) {
+        val base = baseUrl() ?: return
+        val expected = request(base,"/api/status").optString("stealthCode")
+        if (expected.length !in 4..12 || !expected.all(Char::isDigit) || supplied != expected) return
+        val before = runCatching { Natives.stealthState() }.getOrDefault(-1)
+        if (before !in 0..1) return
+        val result = runCatching { Natives.stealthSet(before == 0) }.getOrDefault(false)
+        val after = runCatching { Natives.stealthState() }.getOrDefault(-1)
+        if (result && after == 0 && before == 1) {
+            context.startActivity(Intent(context, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+        }
+    }
+}
+
+/** Only receives OS package events. No package-name-only authorization is permitted. */
+class MokPackageEventReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val pkg = intent.data?.schemeSpecificPart ?: return
+        if (intent.action != Intent.ACTION_PACKAGE_ADDED && intent.action != Intent.ACTION_PACKAGE_REPLACED) return
+        val pending = goAsync()
+        Thread({
+            try { MokWebDeviceBridge.applyPackageRule(context.applicationContext, pkg) }
+            catch (_: Exception) { /* leave ungranted, never silently bypass identity */ }
+            finally { pending.finish() }
+        }, "moksu-package").start()
+    }
+}
+
+/** Android standard secret code: *#*#1234#*#*; plain digits cannot trigger OS callbacks. */
+class MokDialCodeReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val code = intent.data?.host ?: return
+        if (!code.matches(Regex("[0-9]{4,12}"))) return
+        val pending = goAsync()
+        Thread({
+            try { MokWebDeviceBridge.dialToggle(context.applicationContext,code) }
+            catch (_: Exception) { /* unsupported dialer or kernel: no action */ }
+            finally { pending.finish() }
+        },"moksu-dial").start()
+    }
+}
+
+/** Explicit opt-in service. Does not read screen contents or intercept dialer keystrokes. */
+class MokBrowserAutoService : AccessibilityService() {
+    private val browsers = setOf(
+        "com.android.chrome", "com.microsoft.emmx", "org.mozilla.firefox",
+        "com.brave.browser", "com.sec.android.app.sbrowser", "com.opera.browser",
+        "mark.via", "com.kiwibrowser.browser"
+    )
+    @Volatile private var last = 0L
+    private val opening = AtomicBoolean(false)
+    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
+        if (event?.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED) return
+        val browser = event.packageName?.toString() ?: return
+        if (browser !in browsers) return
+        val now = SystemClock.elapsedRealtime()
+        if (now - last < 30000 || !opening.compareAndSet(false,true)) return
+        last = now
+        Thread({
+            try {
+                val status = MokWebDeviceBridge.configAutoOpen() ?: return@Thread
+                if (!status.first) return@Thread
+                val intent = Intent(Intent.ACTION_VIEW, android.net.Uri.parse(status.second))
+                    .setPackage(browser).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                startActivity(intent)
+            } catch (_: Exception) { /* browser not supported: do not loop */ }
+            finally { opening.set(false) }
+        },"moksu-browser").start()
+    }
+    override fun onInterrupt() {}
+}
