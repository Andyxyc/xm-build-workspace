@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+import android.content.ContentUris
+import android.content.Context
+import android.net.Uri
+import android.provider.MediaStore
+import android.os.Build
+
+internal data class MokImageCandidate(val name: String, val uri: Uri)
+
+/** Best-effort recent boot image hints from system-indexed Downloads.
+ * No storage-all-files privilege; SAF remains the authoritative user picker.
+ * Android 11+ may only expose files contributed by this app; an empty result is normal.
+ */
+internal object MokImageCandidates {
+    private val namePattern=Regex("^(init_boot|boot|vendor_boot|recovery)([-_a-zA-Z0-9.]*)\\.img$", RegexOption.IGNORE_CASE)
+    fun scan(context: Context): List<MokImageCandidate> = runCatching {
+        if(Build.VERSION.SDK_INT < 29) return emptyList()
+        val projection=arrayOf(MediaStore.Downloads._ID,MediaStore.Downloads.DISPLAY_NAME)
+        val results=ArrayList<MokImageCandidate>()
+        context.contentResolver.query(MediaStore.Downloads.EXTERNAL_CONTENT_URI,
+            projection, null,null,"${MediaStore.Downloads.DATE_MODIFIED} DESC")?.use { cursor ->
+            val colId=cursor.getColumnIndexOrThrow(MediaStore.Downloads._ID)
+            val colName=cursor.getColumnIndexOrThrow(MediaStore.Downloads.DISPLAY_NAME)
+            while(cursor.moveToNext() && results.size<20) {
+                val name=cursor.getString(colName)?:continue
+                if(name.length>150 || !namePattern.matches(name))continue
+                results.add(MokImageCandidate(name,ContentUris.withAppendedId(
+                    MediaStore.Downloads.EXTERNAL_CONTENT_URI,cursor.getLong(colId))))
+            }
+        }
+        results
+    }.getOrDefault(emptyList())
+}
