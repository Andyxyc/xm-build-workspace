+/// Only when explicitly enabled: check the task currently in foreground using
+/// the already-privileged ksud process. No accessibility API, no screen content.
+/// Some vendor ROMs restrict shell activity queries; in that case this watcher
+/// does nothing, and the user can always open the site manually.
+#[cfg(target_os = "android")]
+fn browser_in_foreground(snapshot: &str) -> Option<&'static str> {
+    const SUPPORTED: &[&str] = &[
+        "com.android.chrome", "com.microsoft.emmx", "org.mozilla.firefox",
+        "com.brave.browser", "com.sec.android.app.sbrowser", "com.opera.browser",
+        "mark.via", "com.kiwibrowser.browser",
+    ];
+    // Prioritize resumed activity, never use a random package appearing in
+    // dumpsys's entire historical task stack.
+    for line in snapshot.lines().filter(|line| {
+        line.contains("topResumedActivity=") || line.contains("mResumedActivity:")
+            || line.contains("topResumedActivity:")
+    }) {
+        if let Some(pkg) = SUPPORTED.iter().find(|pkg| {
+            let pat = format!(" {pkg}/");
+            line.contains(&pat)
+        }) { return Some(pkg); }
+    }
+    None
+}
+
+#[cfg(target_os = "android")]
+fn launch_browser_watch(port: u16) {
+    std::thread::spawn(move || {
+        use std::process::{Command, Stdio};
+        use std::time::Instant;
+        let mut was_foreground: Option<&'static str> = None;
+        let mut last_launch = Instant::now()
+            .checked_sub(Duration::from_secs(45)).unwrap_or_else(Instant::now);
+        loop {
+            let cfg = Config::load();
+            if !cfg.browser_auto || !cfg.enabled || cfg.token.is_empty() {
+                was_foreground = None;
+                std::thread::sleep(Duration::from_secs(4));
+                continue;
+            }
+            let fg = Command::new("/system/bin/dumpsys")
+                .args(["activity", "activities"])
+                .stdin(Stdio::null())
+                .output()
+                .ok()
+                .and_then(|result| if result.status.success() {
+                    String::from_utf8(result.stdout).ok()
+                } else { None })
+                .and_then(|text| browser_in_foreground(&text));
+            if let Some(browser) = fg {
+                if was_foreground != Some(browser) && last_launch.elapsed() > Duration::from_secs(22) {
+                    let url = url_with(port, &cfg.token);
+                    // No shell interpolation: arguments are passed directly to am.
+                    // Access token may appear briefly in the Android activity intent;
+                    // this is why the feature defaults to OFF and supports reset-token.
+                    let started = Command::new("/system/bin/am")
+                        .args(["start", "--user", "0", "-a", "android.intent.action.VIEW",
+                               "-p", browser, "-d", &url])
+                        .stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::null())
+                        .status();
+                    if started.is_ok_and(|s| s.success()) { last_launch = Instant::now(); }
+                }
+            }
+            was_foreground = fg;
+            std::thread::sleep(Duration::from_millis(1600));
+        }
+    });
+}
