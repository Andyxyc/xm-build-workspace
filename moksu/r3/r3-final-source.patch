+import kotlinx.coroutines.withContext
+import me.weishu.kernelsu.Natives
+import me.weishu.kernelsu.ui.MainActivity
+
+/** Verified access: never pretend an unrecognized kernel is healthy. */
+class MokRecoveryActivity:ComponentActivity() {
+    private var input by mutableStateOf("")
+    private var useCard by mutableStateOf(false)
+    private var busy by mutableStateOf(false)
+    private var info by mutableStateOf("")
+    override fun onCreate(savedInstanceState:Bundle?) {
+        super.onCreate(savedInstanceState)
+        window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        setContent { RecoveryScreen() }
+    }
+    private fun submit() {
+        if (busy) return
+        val code=input.trim()
+        if ((!useCard && !code.matches(Regex("[0-9]{4,12}"))) || (useCard && code.length !in 8..128)) {
+            info=if (useCard) "请输入原有访问卡密" else "请输入已设置的数字恢复码"
+            return
+        }
+        busy=true;info="正在验证…"
+        lifecycleScope.launch {
+            val ok=withContext(Dispatchers.IO) {
+                if (useCard) {
+                    val valid=MokActivation.activate(this@MokRecoveryActivity,code) == MokActivation.Result.SUCCESS
+                    if (!valid) false else {
+                        val previous=runCatching { Natives.stealthState() }.getOrDefault(-1)
+                        if (previous == 1) runCatching { Natives.stealthSet(false) }.getOrDefault(false)
+                        runCatching { Natives.stealthState() }.getOrDefault(-1) == 0
+                    }
+                } else MokWebDeviceBridge.dialToggle(this@MokRecoveryActivity,code)
+            }
+            input="";busy=false
+            if (ok) {
+                info="验证成功，正在返回管理器"
+                startActivity(Intent(this@MokRecoveryActivity,MainActivity::class.java)
+                    .addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP))
+                finish()
+            } else info="验证失败或内核不可用，请检查恢复码与内核版本"
+        }
+    }
+    @Composable private fun RecoveryScreen() {
+        MaterialTheme {
+            Scaffold { padding ->
+                Column(modifier=Modifier.fillMaxSize().padding(padding).padding(24.dp),
+                    verticalArrangement=Arrangement.spacedBy(16.dp)) {
+                    Text("管理器验证",style=MaterialTheme.typography.headlineMedium)
+                    Text("验证完成后重新检测内核状态",style=MaterialTheme.typography.bodyMedium)
+                    OutlinedTextField(value=input,onValueChange={if(it.length<=128)input=it},
+                        modifier=Modifier.fillMaxWidth(),label={Text(if(useCard)"访问卡密" else "数字恢复码")},
+                        singleLine=true,visualTransformation=PasswordVisualTransformation(),
+                        keyboardOptions=KeyboardOptions(keyboardType=if(useCard) KeyboardType.Password else KeyboardType.NumberPassword),
+                        enabled=!busy)
+                    Button(onClick={submit()},enabled=!busy,modifier=Modifier.fillMaxWidth()) { Text("验证并恢复") }
+                    TextButton(onClick={ input="";info="";useCard=!useCard },enabled=!busy) {
+                        Text(if(useCard)"使用数字恢复码" else "使用原有访问卡密")
+                    }
+                    if(info.isNotBlank())Text(info,style=MaterialTheme.typography.bodySmall)
+                }
+            }
+        }
+    }
+}
