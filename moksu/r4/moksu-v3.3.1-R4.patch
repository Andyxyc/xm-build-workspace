+    /** Save recovery digits independently of the web server. Atomic replace, root-only
+     * permissions and read-back. Do not log the value or put it in SharedPreferences. */
+    fun setFourDigitCode(code: String): Boolean {
+        if (!code.matches(Regex("[0-9]{4}"))) return false
+        val out = ArrayList<String>()
+        val errors = ArrayList<String>()
+        // Strict decimal input is the only interpolated value; no shell metacharacters.
+        val command = """umask 077
+            mkdir -p /data/adb/sevenk || exit 1
+            tmp=${'$'}(mktemp /data/adb/sevenk/stealth_code.XXXXXX) || exit 2
+            trap 'rm -f "${'$'}tmp"' EXIT
+            printf '%s' '$code' > "${'$'}tmp" || exit 3
+            chmod 600 "${'$'}tmp" || exit 4
+            mv -f "${'$'}tmp" /data/adb/sevenk/stealth_code || exit 5
+            trap - EXIT""".trimIndent()
+        val result = runCatching {
+            getRootShell().newJob().add(command).to(out, errors).exec()
+        }.getOrNull()
+        return result?.code == 0 && configuredDialCode() == code
+    }
+
+    fun dialEntryEnabled(context: Context): Boolean =
+        context.getSharedPreferences("moksu.recovery", Context.MODE_PRIVATE)
+            .getBoolean("dial-entry-enabled", false)
+
+    fun setDialEntryEnabled(context: Context, enabled: Boolean) {
+        context.getSharedPreferences("moksu.recovery", Context.MODE_PRIVATE)
+            .edit().putBoolean("dial-entry-enabled", enabled).apply()
+    }
+
