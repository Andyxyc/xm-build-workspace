@@ -0,0 +1,139 @@
+/* moksu R4: Material 3 surfaces and original functionality; author 心中都是莫.
+   Light and dark both share the same layout, with color-scheme-specific tokens.
+   No obsolete purple-gradient dashboard or imitation root/install cards. */
+[data-theme="7k"][data-scheme="light"]{
+ --bg:#f8f8fc;--bg-soft:#f0f1f8;--card:#fff;--card-2:#f1f2f8;--card-3:#e6e9f4;
+ --line:#e1e4ed;--line-soft:#eceef4;--fg:#1b1c22;--fg-dim:#4e5564;
+ --fg-mute:#72798a;--accent:#5266c7;--accent-fg:#fff;--ok:#287b56;
+ --warn:#b26b10;--bad:#b23f43;--info:#4864b4;--on-strong:#fff;--shadow:0 2px 10px #25294408;
+}
+[data-theme="7k"][data-scheme="dark"]{
+ --bg:#14141b;--bg-soft:#1a1b24;--card:#252630;--card-2:#2d2e3b;--card-3:#373947;
+ --line:#373a48;--line-soft:#353644;--fg:#f0eff7;--fg-dim:#c6c8d6;
+ --fg-mute:#999cad;--accent:#b4c0ff;--accent-fg:#1e2b64;--ok:#8cdaaf;
+ --warn:#ffd18c;--bad:#ffaaa9;--info:#b1c3fb;--on-strong:#181a29;--shadow:none;
+}
+html{scroll-behavior:auto;scroll-padding-top:84px}
+body{background:var(--bg)!important;background-image:none!important;color:var(--fg);font:14px/1.55 system-ui,-apple-system,"Segoe UI","PingFang SC",sans-serif}
+.app-frame{min-height:100dvh;display:grid;grid-template-columns:252px minmax(0,1fr);gap:0}
+.sidebar{position:sticky;top:0;height:100dvh;padding:25px 15px 15px;background:var(--bg-soft)!important;
+ border-right:1px solid var(--line-soft);box-shadow:none!important;display:flex;flex-direction:column;gap:0}
+.brand{padding:8px 16px 27px;display:flex;align-items:center;gap:12px;color:var(--fg)}
+.brand-logo{height:46px;width:46px;border-radius:16px;background:var(--accent)!important;display:grid;place-items:center;box-shadow:none!important}
+.brand-logo .ic{height:25px;width:25px;color:var(--accent-fg)}
+.brand-text strong{font-size:21px;font-weight:730;letter-spacing:-.6px;color:var(--fg)}
+.brand-text span{letter-spacing:.1px;font-size:12px;color:var(--fg-mute)}
+.side-caption{color:var(--fg-mute);font-size:12px;letter-spacing:.4px;font-weight:650;padding:6px 23px 14px}
+.sidebar nav{display:flex;flex-direction:column;gap:4px;padding:0 4px!important;position:static;overflow:visible;background:transparent!important;box-shadow:none!important}
+.sidebar nav button{border:0!important;min-height:53px!important;border-radius:100px!important;padding:10px 18px!important;
+ background:transparent!important;color:var(--fg-dim)!important;display:flex;align-items:center;gap:18px;
+ font-size:14px;font-weight:550;width:100%;box-shadow:none!important;letter-spacing:0}
+.sidebar nav button .ic{width:22px;height:22px;flex:none;color:currentColor}
+.sidebar nav button.on{background:color-mix(in srgb,var(--accent) 16%,var(--card))!important;color:var(--accent)!important;
+ font-weight:720!important;border:none!important}
+.sidebar nav button:not(.on):hover{background:var(--card-2)!important;color:var(--fg)!important}
+.side-spacer{flex:1}
+.side-status{margin:12px 5px 4px;padding:14px;border-radius:20px;background:var(--card);border:none;box-shadow:none}
+.side-status strong{font-weight:630;color:var(--fg)}.side-status small{color:var(--fg-mute);font-size:11px;margin-top:4px}
+.workplace{background:var(--bg)!important;min-height:100dvh}
+.topbar{position:sticky;z-index:9;top:0;height:75px;display:flex;align-items:center;justify-content:space-between;
+ padding:0 clamp(16px,3.5vw,48px);gap:15px;background:color-mix(in srgb,var(--bg) 95%,transparent)!important;
+ border-bottom:1px solid var(--line-soft);backdrop-filter:blur(14px);box-shadow:none}
+.crumb{color:var(--fg);font-size:14px;font-weight:660}.crumb-sep{padding-inline:7px;color:var(--fg-mute)}
+.top-subtitle{color:var(--fg-mute);font-size:12px;margin-top:2px}
+.top-actions{gap:9px}.offline-pill{background:var(--card);border:1px solid var(--line-soft);color:var(--fg-dim);border-radius:100px}
+.icon-btn{height:42px;width:42px;background:var(--card-2);border:0;border-radius:50%;display:grid;place-items:center;color:var(--fg)}
+.icon-btn .ic{width:20px;height:20px}.icon-btn:hover{background:var(--card-3);border:0;color:var(--fg)}
+#main{max-width:1370px;margin:0 auto;padding:32px clamp(17px,3.5vw,48px) 52px}
+.page-heading{display:flex;justify-content:space-between;margin:0 0 23px;padding-left:2px}
+#page-title{font-size:clamp(26px,2.5vw,34px);line-height:1.25;letter-spacing:-.65px;font-weight:760;margin:0 0 5px;color:var(--fg)}
+#page-description{font-size:13px;color:var(--fg-mute)}.page-mark,.eyebrow{display:none!important}
+main section{display:none!important;animation:none!important}
+main section.on{display:block!important}
+#t-status.on{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;gap:15px}
+#t-status>.card,#t-status>.hero{margin:0!important;grid-column:auto;min-width:0}
+#t-status>.hero{grid-column:1/-1;background:var(--card)!important;border:1px solid var(--line-soft)!important;
+ border-radius:28px;min-height:165px;padding:30px 35px;display:flex;align-items:center;gap:25px;box-shadow:none!important}
+.hero .ring,#t-status .hero .ring{width:72px;height:72px;flex:none;border-radius:23px;display:grid;place-items:center;
+ background:color-mix(in srgb,var(--ok) 13%,var(--card))!important;color:var(--ok)!important;border:0!important}
+#t-status .hero.off .ring{background:color-mix(in srgb,var(--warn) 12%,var(--card))!important;color:var(--warn)!important}
+#t-status .hero .ring .ic{width:34px;height:34px}
+.hero .big,#t-status .hero .big{font-size:clamp(21px,2.4vw,31px)!important;color:var(--fg)!important;font-weight:745;line-height:1.35}
+.hero .small,#t-status .hero .small{color:var(--fg-dim)!important;font-size:13px;max-width:620px}
+.card,.mod{background:var(--card)!important;border:1px solid var(--line-soft)!important;border-radius:24px!important;
+ box-shadow:none!important;margin:0;padding:22px!important}
+.card.tight{padding:22px!important}.card-title{color:var(--fg)!important;font-size:15px;font-weight:700;letter-spacing:0;margin-bottom:14px;gap:10px}
+.card-title .ic{color:var(--accent);width:20px;height:20px}
+#t-status>.card:last-child{grid-column:auto!important}
+.row{padding:11px 0;gap:9px}.row+.row{border-top:1px solid var(--line-soft)}
+.row .k{color:var(--fg-mute);font-size:12px}.row .v{color:var(--fg);font-size:12px}
+.stats{gap:12px}.stat{background:var(--bg-soft)!important;border:0;border-radius:18px;padding:16px;gap:12px}
+.stat .ic{color:var(--accent);width:23px;height:23px}.stat .n{color:var(--fg);font-size:25px}.stat .l{color:var(--fg-mute)}
+.btn{min-height:41px;border:1px solid var(--line-soft)!important;border-radius:999px!important;padding:9px 16px;
+ background:var(--card-2)!important;color:var(--fg);font-size:13px;font-weight:620;box-shadow:none!important}
+.btn.primary{background:var(--accent)!important;border-color:var(--accent)!important;color:var(--accent-fg)!important}
+.btn.danger{background:color-mix(in srgb,var(--bad) 11%,var(--card))!important;color:var(--bad)}
+.btn:hover{filter:none;background:var(--card-3)!important}.btn.primary:hover{filter:brightness(1.06);background:var(--accent)!important}
+.section-intro{display:flex;justify-content:space-between;align-items:baseline;gap:15px;margin:0 0 16px;padding:0 2px}
+.section-intro strong{font-size:16px;color:var(--fg)}.section-intro span{font-size:12px;color:var(--fg-mute)}
+.toolbar{gap:12px;flex-wrap:wrap;margin-bottom:16px}.search{background:var(--card);border:1px solid var(--line);border-radius:22px;min-height:49px;flex:1;min-width:min(240px,100%)}
+.search input{background:transparent;outline:none}.search:focus-within{border-color:var(--accent)}
+.chips{gap:7px;margin:11px 0 17px}.chip{border-radius:999px;background:var(--card-2);color:var(--fg-dim);padding:8px 15px;border:1px solid var(--line-soft)}
+.chip.on{background:color-mix(in srgb,var(--accent) 14%,var(--card));color:var(--accent);border-color:color-mix(in srgb,var(--accent) 40%,var(--card));font-weight:700}
+#users{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;align-items:stretch}
+#users .mod{padding:18px!important;border-radius:23px!important;min-width:0}
+#users .m-name{font-size:15px!important;font-weight:700;line-height:1.5;display:flex;align-items:center;flex-wrap:wrap;gap:5px}
+#users .m-meta{color:var(--fg-mute);margin-top:3px;overflow-wrap:anywhere;font-size:11.5px}
+#users .ava{width:52px;height:52px;border-radius:17px;border:1px solid var(--line-soft);background:var(--bg-soft);overflow:hidden}
+#users .ava img{width:100%;height:100%;object-fit:cover}
+#users .acts{padding-top:13px!important;gap:7px}
+#modules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
+.mod .ava{background:var(--card-2)!important;border-color:var(--line-soft)}
+.mod .acts{border-top:1px solid var(--line-soft)}.mod .m-name{font-weight:710;color:var(--fg)}
+.sw{border-radius:99px;width:52px;height:30px;background:var(--card-3);border:1px solid var(--line)}
+.sw::after{width:22px;height:22px;left:3px;top:3px;background:var(--fg-mute)}
+.sw.on{background:var(--accent);border-color:var(--accent)}.sw.on::after{background:var(--accent-fg);transform:translateX(21px)}
+.security-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
+.security-grid>.card{padding:23px!important}.security-title{font-weight:720;color:var(--fg)}
+.fld+.fld{border-top:1px solid var(--line-soft)}
+#mask{z-index:72!important;background:#11132096;backdrop-filter:blur(4px)}
+.sheet{background:var(--card);border:1px solid var(--line);border-radius:28px;box-shadow:0 22px 72px #090b1740}
+.app-footer{color:var(--fg-mute);font-size:12px;padding-top:28px}
+.metadata-hint{grid-column:1/-1;background:var(--card-2);color:var(--fg-dim);border-radius:16px;padding:12px 15px;font-size:12px}
+.mobile-nav{display:none}
+@media(max-width:1020px){.app-frame{grid-template-columns:84px minmax(0,1fr)}
+ .sidebar{padding-inline:11px}.brand{padding:10px 6px 24px;justify-content:center}.brand-text,.side-caption,.side-status,.sidebar nav button span{display:none!important}
+ .sidebar nav button{justify-content:center;padding:11px!important}.sidebar nav button .ic{width:24px;height:24px}
+ #t-status.on{grid-template-columns:1fr 1fr}}
+@media(max-width:700px){
+ .app-frame{display:block;min-height:100dvh}.sidebar{display:none!important}
+ .workplace{padding-bottom:0}.topbar{height:65px;padding:0 16px}
+ .top-subtitle{display:none}.topbar .crumb{font-size:14px}.offline-pill{padding:7px 10px;font-size:11px}
+ .top-actions{gap:5px}.icon-btn{width:39px;height:39px}
+ #main{padding:24px 15px calc(110px + env(safe-area-inset-bottom))}
+ #page-title{font-size:28px}.page-heading{margin-bottom:20px}
+ #t-status.on{grid-template-columns:minmax(0,1fr);gap:13px}
+ #t-status>.hero{grid-column:1!important;min-height:135px;padding:20px 19px;gap:16px;border-radius:24px}
+ #t-status .hero .ring{width:57px;height:57px;border-radius:17px}
+ #t-status .hero .ring .ic{width:27px;height:27px}
+ #t-status .hero .big{font-size:22px!important}
+ #t-status .hero .small{font-size:12px}
+ #t-status>.card{grid-column:1!important}
+ .card,.mod,.card.tight{padding:18px!important;border-radius:23px!important}
+ #users,#modules,.security-grid{grid-template-columns:1fr}
+ .section-intro{display:flex;flex-direction:column;align-items:flex-start;gap:2px}
+ .toolbar{flex-wrap:wrap}.search{width:100%}
+ .mobile-nav{display:flex;flex-direction:row!important;position:fixed;top:auto!important;overflow:hidden;z-index:22;left:0;right:0;bottom:0;align-items:stretch;justify-content:space-around;
+ background:color-mix(in srgb,var(--card) 95%,transparent);border-top:1px solid var(--line-soft);
+ backdrop-filter:blur(18px);height:calc(69px + env(safe-area-inset-bottom));padding:6px 4px env(safe-area-inset-bottom)}
+ .mobile-nav button{display:flex;flex:1 1 0;width:auto;min-width:0;align-items:center;justify-content:center;gap:2px;flex-direction:column;
+ background:transparent;border:0;border-radius:15px;color:var(--fg-mute);font-size:10.5px;padding:5px 1px;white-space:nowrap}
+ .mobile-nav .ic{width:22px;height:22px;stroke-width:2.2}
+ .mobile-nav button.on{color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent);font-weight:700}
+ #mask{align-items:flex-end;padding:0}
+ .sheet{max-height:93dvh;width:100%;border-radius:28px 28px 0 0;padding:24px 18px calc(26px + env(safe-area-inset-bottom))}
+ .sheet .grip{display:block;width:35px;height:4px;border-radius:5px;background:var(--line);margin:0 auto 18px}
+ .sheet.full{width:100%;max-width:none;height:94dvh;max-height:94dvh}
+ #toast{bottom:calc(86px + env(safe-area-inset-bottom));max-width:90vw}
+}
+@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
