+import javax.crypto.KeyGenerator
+import javax.crypto.Mac
+import javax.crypto.SecretKey
+
+/** The package id cannot be modified at runtime. Three launcher aliases have distinct labels/icons. */
+object MokDisguise {
+    const val NORMAL = "normal"
+    const val CALCULATOR = "calculator"
+    const val CALENDAR = "calendar"
+    private const val PREF = "moksu.disguise.v1"
+    private const val KEY_ALIAS = "moksu.disguise.recovery.hmac.v1"
+    private val sixDigits = Regex("[0-9]{6}")
+    private val names = mapOf(
+        NORMAL to "me.weishu.kernelsu.mok.MokManagerLauncher",
+        CALCULATOR to "me.weishu.kernelsu.mok.MokCalculatorLauncher",
+        CALENDAR to "me.weishu.kernelsu.mok.MokCalendarLauncher"
+    )
+
+    fun mode(context: Context): String = context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+        .getString("mode", NORMAL).orEmpty().takeIf { names.containsKey(it) } ?: NORMAL
+
+    private fun key(): SecretKey {
+        val ks = KeyStore.getInstance("AndroidKeyStore")
+        ks.load(null)
+        (ks.getKey(KEY_ALIAS, null) as? SecretKey)?.let { return it }
+        val gen = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_HMAC_SHA256, "AndroidKeyStore")
+        gen.init(KeyGenParameterSpec.Builder(KEY_ALIAS,
+            KeyProperties.PURPOSE_SIGN or KeyProperties.PURPOSE_VERIFY)
+            .setDigests(KeyProperties.DIGEST_SHA256).build())
+        return gen.generateKey()
+    }
+    private fun tag(pin: String): String {
+        val mac = Mac.getInstance("HmacSHA256")
+        mac.init(key())
+        return android.util.Base64.encodeToString(mac.doFinal(
+            ("moksu-disguise-pin-v1\u0000" + pin).toByteArray(Charsets.UTF_8)), android.util.Base64.NO_WRAP)
+    }
+    fun configured(context: Context): Boolean = context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+        .getString("pin-tag", null)?.isNotBlank() == true
+    /** No six-digit plaintext or unsalted offline-bruteforceable hash is persisted. */
+    fun setPin(context: Context, first: String, second: String): Boolean {
+        if (!sixDigits.matches(first) || first != second) return false
+        return runCatching {
+            val value = tag(first)
+            context.getSharedPreferences(PREF, Context.MODE_PRIVATE).edit()
+                .putString("pin-tag", value).putInt("attempts",0)
+                .putLong("lock-until",0).commit() && configured(context)
+        }.getOrDefault(false)
+    }
+    @Synchronized fun verify(context: Context, entered: String): Boolean {
+        if (!sixDigits.matches(entered)) return false
+        val prefs = context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+        if (SystemClock.elapsedRealtime() < prefs.getLong("lock-until",0)) return false
+        val stored = prefs.getString("pin-tag",null) ?: return false
+        val good = runCatching {
+            MessageDigest.isEqual(stored.toByteArray(Charsets.US_ASCII),
+                tag(entered).toByteArray(Charsets.US_ASCII))
+        }.getOrDefault(false)
+        if (good) {
+            prefs.edit().putInt("attempts",0).putLong("lock-until",0).commit()
+        } else {
+            val n = prefs.getInt("attempts",0) + 1
+            prefs.edit().putInt("attempts",if(n>=5)0 else n)
+                .putLong("lock-until",if(n>=5)SystemClock.elapsedRealtime()+300_000L else 0L)
+                .commit()
+        }
+        return good
+    }
+
+    /** Enable incoming launcher first, then disable old aliases; leave current package and signing unchanged. */
+    @Synchronized fun setMode(context: Context, next: String): Boolean {
+        if (!names.containsKey(next) || (next != NORMAL && !configured(context))) return false
+        val pm = context.packageManager
+        val previous = mode(context)
+        val target = ComponentName(context, names.getValue(next))
+        return runCatching {
+            pm.setComponentEnabledSetting(target, PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
+                PackageManager.DONT_KILL_APP)
+            for ((type, alias) in names) if (type != next) {
+                pm.setComponentEnabledSetting(ComponentName(context,alias),
+                    PackageManager.COMPONENT_ENABLED_STATE_DISABLED, PackageManager.DONT_KILL_APP)
+            }
+            check(context.getSharedPreferences(PREF,Context.MODE_PRIVATE).edit().putString("mode",next).commit())
+            true
+        }.getOrElse {
+            // Never strand the user with no launcher icon: attempt to reinstate former alias.
+            runCatching {
+                pm.setComponentEnabledSetting(ComponentName(context,names.getValue(previous)),
+                    PackageManager.COMPONENT_ENABLED_STATE_ENABLED,PackageManager.DONT_KILL_APP)
+            }
+            false
+        }
+    }
+}
+
+/** Native, functional calculator/calendar front surfaces, with an explicit recovery gesture.
+ * A long-press on = (calculator) or on the displayed month (calendar) is required.
+ */
+class MokDisguiseActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState:Bundle?) {
+        super.onCreate(savedInstanceState)
+        val mode = MokDisguise.mode(this)
+        // A disabled alias may be retained in an OEM launcher cache; do not expose control panel.
+        if (mode == MokDisguise.NORMAL) { finish(); return }
+        window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        setContent {
+            KernelSUTheme(uiMode = UiMode.Material) {
+                Surface(Modifier.fillMaxSize(),color=MaterialTheme.colorScheme.background) {
+                    if (mode == MokDisguise.CALENDAR) CalendarFace { reveal(it) }
+                    else CalculatorFace { reveal(it) }
+                }
+            }
+        }
+    }
+    private fun reveal(pin: String) {
+        if (!MokDisguise.verify(this, pin)) return
+        // Allow manager login only after the native kernel confirms hidden mode was lifted.
+        val previous = runCatching { Natives.stealthState() }.getOrDefault(-1)
+        if (previous == 1) {
+            if (!runCatching { Natives.stealthSet(false) }.getOrDefault(false) ||
+                runCatching { Natives.stealthState() }.getOrDefault(-1) != 0) return
+        }
+        startActivity(Intent(this,MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP))
+        finish()
+    }
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable private fun CalculatorFace(onUnlock:(String)->Unit) {
+    var display by remember { mutableStateOf("0") }
+    var previous by remember { mutableStateOf<BigDecimal?>(null) }
+    var op by remember { mutableStateOf<String?>(null) }
+    var fresh by remember { mutableStateOf(true) }
+    fun process(key:String) {
+        when(key) {
+            "AC" -> {display="0";previous=null;op=null;fresh=true}
+            "±" -> {display=if(display.startsWith("-"))display.drop(1) else "-$display"}
+            "%" -> { display=runCatching { BigDecimal(display).divide(BigDecimal(100)).stripTrailingZeros().toPlainString() }.getOrDefault(display) }
+            "+", "−", "×", "÷" -> {
+                previous=display.toBigDecimalOrNull();op=key;fresh=true
+            }
+            "=" -> {
+                val a=previous;val b=display.toBigDecimalOrNull()
+                if (a!=null && b!=null && op!=null) {
+                    display=runCatching { when(op) {
+                        "+" -> a.add(b); "−" -> a.subtract(b)
+                        "×" -> a.multiply(b); else -> a.divide(b,MathContext.DECIMAL64)
+                    }.stripTrailingZeros().toPlainString() }.getOrDefault("错误")
+                }
+                previous=null;op=null;fresh=true
+            }
+            else -> if(key.matches(Regex("[0-9.]"))) {
+                if(key=="." && !fresh && display.contains('.')) return
+                display=when {
+                    fresh && key=="." -> "0."
+                    fresh || display=="0" -> key
+                    display.length>=18 -> display
+                    else -> display+key
+                }
+                fresh=false
+            }
+        }
+    }
+    Column(Modifier.fillMaxSize().padding(horizontal=20.dp, vertical=16.dp),verticalArrangement=Arrangement.Bottom) {
+        Text(display,modifier=Modifier.fillMaxWidth().padding(end=10.dp,bottom=22.dp),
+            fontSize=48.sp,textAlign=androidx.compose.ui.text.style.TextAlign.End,maxLines=1)
+        val rows=listOf(listOf("AC","±","%","÷"),listOf("7","8","9","×"),listOf("4","5","6","−"),listOf("1","2","3","+"),listOf("0",".","="))
+        rows.forEach { row ->
+            Row(Modifier.fillMaxWidth().padding(vertical=5.dp),horizontalArrangement=Arrangement.spacedBy(10.dp)) {
+                row.forEach { key ->
+                    val bg=if(key in listOf("÷","×","−","+","=")) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.surfaceVariant
+                    Box(Modifier.weight(if(key=="0"&&row.size==3)2f else 1f).height(66.dp)
+                        .background(bg,RoundedCornerShape(38.dp))
+                        .combinedClickable(onClick={ process(key) },onLongClick={
+                            if(key=="=" && display.matches(Regex("[0-9]{6}"))) onUnlock(display)
+                        }),contentAlignment=Alignment.Center) {
+                        Text(key,fontSize=24.sp,fontWeight=FontWeight.Medium,color=MaterialTheme.colorScheme.onSurface)
+                    }
+                }
+            }
+        }
+    }
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable private fun CalendarFace(onUnlock:(String)->Unit) {
+    var month by remember { mutableStateOf(YearMonth.now()) }
+    var selected by remember { mutableStateOf(LocalDate.now()) }
+    var showPin by remember { mutableStateOf(false) }
+    var entry by remember { mutableStateOf("") }
+    val today = remember { LocalDate.now() }
+    val days = listOf("一","二","三","四","五","六","日")
+    Column(Modifier.fillMaxSize().padding(horizontal=18.dp, vertical=28.dp)) {
+        Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween,verticalAlignment=Alignment.CenterVertically) {
+            Text("日历",fontSize=30.sp,fontWeight=FontWeight.SemiBold)
+            TextButton(onClick={ month=YearMonth.now();selected=today }) { Text("今天") }
+        }
+        Spacer(Modifier.height(26.dp))
+        Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.SpaceBetween,verticalAlignment=Alignment.CenterVertically) {
+            TextButton(onClick={month=month.minusMonths(1)}) {Text("‹",fontSize=28.sp)}
+            Box(Modifier.combinedClickable(onClick={},onLongClick={showPin=true}),contentAlignment=Alignment.Center) {
+                Text("${month.year}年 ${month.monthValue}月",fontSize=20.sp,fontWeight=FontWeight.Medium)
+            }
+            TextButton(onClick={month=month.plusMonths(1)}) {Text("›",fontSize=28.sp)}
+        }
+        Spacer(Modifier.height(24.dp))
+        Row(Modifier.fillMaxWidth()) { days.forEach { d -> Box(Modifier.weight(1f),contentAlignment=Alignment.Center) { Text(d,color=MaterialTheme.colorScheme.onSurfaceVariant) } } }
+        Spacer(Modifier.height(12.dp))
+        val offset=month.atDay(1).dayOfWeek.value-1
+        val dates=(0 until offset).map { null }+(1..month.lengthOfMonth()).map {month.atDay(it)}
+        LazyVerticalGrid(columns=GridCells.Fixed(7),modifier=Modifier.fillMaxWidth().height(365.dp),userScrollEnabled=false) {
+            items(dates) { date ->
+                Box(Modifier.fillMaxWidth().height(50.dp),contentAlignment=Alignment.Center) {
+                    if(date!=null) {
+                        val active=selected==date
+                        TextButton(onClick={selected=date},contentPadding=PaddingValues(0.dp),
+                            colors=ButtonDefaults.textButtonColors(containerColor=if(active) MaterialTheme.colorScheme.primaryContainer else Color.Transparent)) {
+                            Text(date.dayOfMonth.toString(),fontSize=16.sp,color=if(date==today)MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurface)
+                        }
+                    }
+                }
+            }
+        }
+        Spacer(Modifier.height(10.dp))
+        Text("${selected.monthValue}月${selected.dayOfMonth}日 · ${selected.dayOfWeek.getDisplayName(java.time.format.TextStyle.FULL,java.util.Locale.CHINA)}",fontSize=16.sp)
+    }
+    if(showPin) AlertDialog(onDismissRequest={showPin=false;entry=""},title={Text("输入六位数字")},
+        text={OutlinedTextField(entry,{if(it.length<=6&&it.all(Char::isDigit))entry=it},singleLine=true,
+            keyboardOptions=KeyboardOptions(keyboardType=KeyboardType.NumberPassword),visualTransformation=androidx.compose.ui.text.input.PasswordVisualTransformation())},
+        confirmButton={TextButton(onClick={val p=entry;entry="";showPin=false;onUnlock(p)},enabled=entry.length==6){Text("确定")}},
+        dismissButton={TextButton(onClick={showPin=false;entry=""}){Text("取消")}})
+}
