@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+import android.content.Context
+import java.security.SecureRandom
+
+/** User-shareable installation identifier, not IMEI, SIM, serial, Android ID or hardware fingerprint. */
+object MokDeviceCode {
+    private val valid = Regex("MO-[0-9A-F]{24}")
+    @Synchronized fun get(context: Context): String {
+        val prefs = context.getSharedPreferences("moksu.device-code.v1", Context.MODE_PRIVATE)
+        val old = prefs.getString("code", "") ?: ""
+        if (valid.matches(old)) return old
+        val value = ByteArray(12).also(SecureRandom()::nextBytes)
+        val code = "MO-" + value.joinToString("") { "%02X".format(it.toInt() and 0xff) }
+        if (!prefs.edit().putString("code",code).commit()) return ""
+        return code
+    }
+}
