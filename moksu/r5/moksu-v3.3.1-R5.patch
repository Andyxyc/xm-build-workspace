index 0000000..39cb04e
--- /dev/null
+++ b/tools/issue_flash_permit.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Issue device-bound, signed moksu flash permit (never embeds issuer secret into Android APK).
+Usage (on owner's own PC, with original signing P12 kept private):
+  python issue_flash_permit.py --p12 /private/signing-key.p12 \
+    --device MO-0123456789ABCDEF01234567 --hours 24 --out flash-permit.txt
+Requires: pip install cryptography
+Enter P12 password in a concealed prompt. The signer's cert must match moksu v3.3.1.
+"""
+from __future__ import annotations
+import argparse
+import base64
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+import getpass
+import os
+import re
+import uuid
+import hashlib
+
+EXPECTED_CERT_SHA256="df131f3197ed55a19d7e0a86a2b04635a5c0e5ea4bf9b596fef5a8e1d5bbcbd8"
+
+
+def sign(p12_path: Path, device: str, hours: int, out: Path, operations: str="patch,flash") -> str:
+    from cryptography.hazmat.primitives.serialization import pkcs12, Encoding
+    from cryptography.hazmat.primitives.asymmetric import padding, rsa
+    from cryptography.hazmat.primitives import hashes
+    if not re.fullmatch(r"MO-[0-9A-F]{24}",device): raise ValueError("invalid device installation code")
+    if not 1<=hours<=24*30:raise ValueError("validity must be 1..720h")
+    if operations not in {"patch","flash","patch,flash"}:raise ValueError("invalid operations")
+    if out.exists():raise FileExistsError(f"Output exists; refusing overwrite: {out}")
+    pw=getpass.getpass("P12 password: ")
+    try:
+        key, cert, _=pkcs12.load_key_and_certificates(p12_path.read_bytes(), pw.encode())
+    finally:
+        del pw
+    if cert is None or key is None or not isinstance(key, rsa.RSAPrivateKey):raise ValueError("RSA signing certificate/private key not found")
+    if hashlib.sha256(cert.public_bytes(Encoding.DER)).hexdigest()!=EXPECTED_CERT_SHA256:
+        raise ValueError("signing key certificate does not match moksu original")
+    expiry=(datetime.now(timezone.utc)+timedelta(hours=hours)).replace(microsecond=0).isoformat().replace("+00:00","Z")
+    content=f"MOKSU-FLASH-1\ndevice={device}\nexpires={expiry}\noperations={operations}\nserial={uuid.uuid4()}\n"
