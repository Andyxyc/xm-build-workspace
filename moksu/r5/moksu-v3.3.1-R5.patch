@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package me.weishu.kernelsu.mok
+
+import android.content.Context
+import android.net.Uri
+import me.weishu.kernelsu.R
+import java.io.File
+import java.security.MessageDigest
+import java.security.Signature
+import java.security.cert.CertificateFactory
+import java.time.Instant
+import java.util.Base64
+import java.util.UUID
+
+/** Offline, owner-issued, device-specific permit for boot patch and direct flash.
+ * Canonical signed UTF-8 format is fixed and size limited. No fixed card/password in APK.
+ * This gates the app's operation entrypoints; root owners still have independent fastboot/ADB.
+ */
+object MokFlashPermit {
+    const val HEADER = "MOKSU-FLASH-1"
+    private const val FILE = "owner-flash-authorization.txt"
+    private const val MAX = 4096
+    private val devicePattern = Regex("MO-[0-9A-F]{24}")
+    private val serialPattern = Regex("[0-9a-fA-F-]{36}")
+
+    data class Permit(val device: String, val expiry: Instant, val operations: Set<String>, val serial: String)
+
+    private fun parseAndVerify(context: Context, raw: ByteArray): Permit? = runCatching {
+        if(raw.size > MAX || raw.isEmpty()) return null
+        val text = raw.toString(Charsets.UTF_8)
+        val lines = text.trimEnd('\n').split('\n')
+        if(lines.size != 6 || lines[0] != HEADER || lines.any { it.contains('\r') }) return null
+        val device = lines[1].removePrefix("device=")
+        val expires = lines[2].removePrefix("expires=")
+        val operations = lines[3].removePrefix("operations=")
+        val serial = lines[4].removePrefix("serial=")
+        if(!lines[1].startsWith("device=") || !lines[2].startsWith("expires=") ||
+            !lines[3].startsWith("operations=") || !lines[4].startsWith("serial=") ||
+            !lines[5].startsWith("signature=")) return null
+        if(!devicePattern.matches(device) || device != MokDeviceCode.get(context)) return null
+        val until = Instant.parse(expires)
+        if(until.isBefore(Instant.now()) || until.isAfter(Instant.now().plusSeconds(31L*24*3600))) return null
+        if(!serialPattern.matches(serial)) return null
+        val scopes=operations.split(',').toSet()
+        if(scopes.isEmpty() || scopes.any { it !in setOf("patch","flash") } || scopes.joinToString(",") != operations) return null
+        val signBytes = (lines.take(5).joinToString("\n")+"\n").toByteArray(Charsets.UTF_8)
+        val encoded = lines[5].removePrefix("signature=")
+        val sig = Base64.getDecoder().decode(encoded)
+        val cert=context.resources.openRawResource(R.raw.moksu_flash_verify_cert).use { stream ->
+            CertificateFactory.getInstance("X.509").generateCertificate(stream)
+        }
+        val verify=Signature.getInstance("SHA256withRSA")
+        verify.initVerify(cert.publicKey)
+        verify.update(signBytes)
+        if(!verify.verify(sig)) return null
+        Permit(device, until, scopes, serial)
+    }.getOrNull()
+
+    private fun file(context: Context): File = File(context.filesDir, FILE)
