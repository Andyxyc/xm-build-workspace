+/** Purely a manager UI presentation option. Never claims to remove root. */
+internal object MokDisplayState {
+    private const val PREF = "moksu.presentation.v1"
+    private const val KEY = "uninstalled_ui"
+    fun showUninstalled(context: Context): Boolean =
+        context.getSharedPreferences(PREF, Context.MODE_PRIVATE).getBoolean(KEY, false)
+
+    fun setUninstalled(context: Context, enabled: Boolean): Boolean {
+        val result = context.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+            .edit().putBoolean(KEY, enabled).commit()
+        if (result) MokWebDeviceBridge.syncAppearanceAsync(context.applicationContext)
+        return result
+    }
+}
