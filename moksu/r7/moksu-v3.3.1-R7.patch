+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Prepare a SEPARATE installable package variant without leaking signing keys.
+
+This does not modify the installed Android package. Build and sign the copied
+sources with the owner's existing signing key after testing recovery on a spare
+Android device. Separate variants don't carry old app private data.
+"""
+import argparse, json, pathlib, secrets, shutil, re, hashlib
+
+TYPES={"calculator":("计算器","@drawable/mok_calc_icon"),
+       "calendar":("日历","@drawable/mok_calendar_icon")}
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument('--source',type=pathlib.Path,required=True)
+    p.add_argument('--output',type=pathlib.Path,required=True)
+    p.add_argument('--kind',choices=sorted(TYPES),required=True)
+    p.add_argument('--package',default=None,help='New unique app ID; default generated')
+    a=p.parse_args()
+    path=a.package or ('com.mobitools.app.p'+secrets.token_hex(5))
+    if len(path)>130 or not re.fullmatch(r'(?:[a-z][a-z0-9_]*\.){2,5}[a-z][a-z0-9_]*',path):
+        p.error('Invalid Android package name')
+    if a.source.resolve()==a.output.resolve() or a.output.resolve().is_relative_to(a.source.resolve()):
+        p.error('Output must be separate from the source project')
+    if a.output.exists():p.error('Destination already exists (nothing overwritten)')
+    manifest=a.source/'manager/app/src/main/AndroidManifest.xml'
+    if not manifest.is_file():p.error('Source tree is missing AndroidManifest.xml')
+    label,icon=TYPES[a.kind]
+    def ignore(path, names):
+        return {n for n in names if n in {'.git','.gradle','build','target','.idea','.cxx','node_modules'}}
+    shutil.copytree(a.source,a.output,ignore=ignore)
+    dest=a.output/'manager/app/src/main/AndroidManifest.xml'
+    text=dest.read_text(encoding='utf-8')
+    needle='android:icon="@mipmap/ic_launcher" android:label="@string/app_name"'
+    if text.count(needle)!=1:
+        shutil.rmtree(a.output)
+        p.error('Android manifest has changed; no variant created')
+    dest.write_text(text.replace(needle,f'android:icon="{icon}" android:label="{label}"'),encoding='utf-8')
+    build_hint={
+        'package_name':path,'flavor':a.kind,'app_label':label,'icon_source':icon,
+        'data_migration':'not automatic; fresh application data and Android Keystore',
+        'signed':False,'device_tested':False,'author':'闲鱼 心中都是莫'
+    }
+    (a.output/'R7_VARIANT_INFO.json').write_text(json.dumps(build_hint,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
+    (a.output/'R7_VARIANT_BUILD.txt').write_text(
+        'Build from a trusted Android SDK environment:\n'
+        f'cd manager && ./gradlew :app:assembleRelease -PKSU_NAME=moksu -PKSU_PACKAGE_NAME={path} -PKSU_VERSION_NAME=3.3.1-R7\n'
+        'This builds an UNSIGNED candidate. Sign with the original owner private key locally; do not put keys into GitHub Actions.\n'
+        'Do not uninstall old manager until independently verifying root and recovery.\n',encoding='utf-8')
+    print('Package:',path)
+    print('Staged project:',a.output)
+    print('Unsigned build guidance:',a.output/'R7_VARIANT_BUILD.txt')
+if __name__=='__main__':main()
