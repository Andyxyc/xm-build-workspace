+/** Calculator and calendar intentionally use their own tool palettes, not the manager's theme. */
+@Composable internal fun MokToolTheme(calendar: Boolean, content: @Composable () -> Unit) {
+    val dark = isSystemInDarkTheme()
+    val accent = if (calendar) Color(0xFF3978EE) else Color(0xFFFF8126)
+    val scheme = if (dark) darkColorScheme(
+        primary=accent, background=Color(0xFF141519),surface=Color(0xFF141519),
+        surfaceContainer=Color(0xFF25262B),surfaceContainerLow=Color(0xFF1F2025),
+        onSurface=Color(0xFFF4F4F5),onBackground=Color(0xFFF4F4F5))
+    else lightColorScheme(
+        primary=accent, background=Color(0xFFF8F9FC),surface=Color.White,
+        surfaceContainer=Color(0xFFF0F1F6),surfaceContainerLow=Color.White,
+        onSurface=Color(0xFF202329),onBackground=Color(0xFF202329))
+    MaterialTheme(colorScheme=scheme, content=content)
+}
+
+private object CalcHistory {
+    private const val PREF="moksu.calculator.history.v1"
+    fun read(context: Context): List<Pair<String,String>> = runCatching {
+        val v=JSONArray(context.getSharedPreferences(PREF,Context.MODE_PRIVATE)
+            .getString("history", "[]") ?: "[]")
+        (0 until minOf(30,v.length())).mapNotNull { index ->
+            val a=v.optJSONArray(index) ?: return@mapNotNull null
+            val exp=a.optString(0).take(80)
+            val value=a.optString(1).take(60)
+            if(exp.isEmpty() || value.isEmpty()) null else exp to value
+        }
+    }.getOrDefault(emptyList())
+    fun append(context:Context, expr:String, value:String) {
+        val history=(listOf(expr to value)+read(context)).take(30)
+        val array=JSONArray()
+        history.forEach { (e,v)-> array.put(JSONArray().put(e).put(v)) }
+        context.getSharedPreferences(PREF,Context.MODE_PRIVATE).edit()
+            .putString("history",array.toString()).apply()
+    }
+    fun clear(context:Context) {
+        context.getSharedPreferences(PREF,Context.MODE_PRIVATE).edit().remove("history").apply()
+    }
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable internal fun MokCalculatorV7(onUnlock: (String)->Unit) {
+    val context=LocalContext.current
+    val scheme=MaterialTheme.colorScheme
+    var display by remember { mutableStateOf("0") }
+    var expression by remember { mutableStateOf("") }
+    var operand by remember { mutableStateOf<BigDecimal?>(null) }
+    var pending by remember { mutableStateOf<String?>(null) }
+    var replace by remember { mutableStateOf(true) }
+    var science by remember { mutableStateOf(false) }
+    var historyVisible by remember { mutableStateOf(false) }
+    var historyTick by remember { mutableStateOf(0) }
+    var lastEqualsMs by remember { mutableLongStateOf(0L) }
+    val mode=MokDisguise.calculatorUnlockMethod(context)
+    fun format(d:BigDecimal):String {
+        val output=d.round(MathContext.DECIMAL64).stripTrailingZeros().toPlainString()
+        return if (output.length > 38) d.round(MathContext(12)).toString() else output
+    }
+    fun calculate():Unit {
+        val first=operand; val second=display.toBigDecimalOrNull(); val action=pending
+        if(first == null || second==null || action==null) {replace=true;return}
+        val result=runCatching { when(action) {
+            "+" -> first.add(second)
+            "−" -> first.subtract(second)
+            "×" -> first.multiply(second)
+            "÷" -> first.divide(second,MathContext.DECIMAL64)
+            else -> second
+        } }.getOrNull()
+        val exp="${format(first)} $action ${format(second)}"
+        expression="$exp ="
+        display=if(result==null) "无法计算" else format(result)
+        if(result!=null) { CalcHistory.append(context,exp,display);historyTick++ }
+        operand=null;pending=null;replace=true
+    }
+    fun applyScience(key:String) {
+        val number=display.toDoubleOrNull() ?: return
+        val next=when(key) {
+            "sin" -> sin(Math.toRadians(number))
+            "cos" -> cos(Math.toRadians(number))
+            "tan" -> tan(Math.toRadians(number))
+            "√" -> sqrt(number)
+            "x²" -> number*number
+            "1/x" -> 1.0/number
+            "π" -> Math.PI
+            else -> number
+        }
+        if(next.isFinite()) {
+            expression="$key($display)"
+            display=BigDecimal.valueOf(next).round(MathContext(12)).stripTrailingZeros().toPlainString()
+            replace=true
+        } else {display="无法计算";replace=true}
+    }
+    fun tap(key:String) {
+        when(key) {
+            "AC" -> { display="0"; expression=""; operand=null;pending=null;replace=true;lastEqualsMs=0 }
+            "⌫" -> { display=if(display.length<=1||display=="无法计算") "0" else display.dropLast(1);replace=false }
+            "±" -> { display=if(display.startsWith("-")) display.drop(1) else if(display!="0") "-$display" else "0" }
+            "%" -> { display=runCatching { format(BigDecimal(display).divide(BigDecimal(100))) }.getOrDefault(display) }
+            "+","−","×","÷" -> {
+                if(pending!=null && operand!=null && !replace) calculate()
+                operand=display.toBigDecimalOrNull();pending=key;replace=true
+                expression="$display $key"
+            }
+            "=" -> {
+                val possiblePin=pending==null && operand==null && display.matches(Regex("[0-9]{6}"))
+                if(possiblePin && mode==MokDisguise.UNLOCK_TAP) { onUnlock(display);lastEqualsMs=0;return }
+                if(possiblePin && mode==MokDisguise.UNLOCK_DOUBLE) {
+                    val now=SystemClock.elapsedRealtime()
+                    if(lastEqualsMs>0 && now-lastEqualsMs in 100..1350) {
+                        lastEqualsMs=0;onUnlock(display);return
+                    }
+                    lastEqualsMs=now
+                    return
+                }
+                lastEqualsMs=0
+                calculate()
+            }
+            "." -> {
+                if(replace) {display="0.";replace=false}
+                else if(!display.contains('.')) display+="."
+            }
+            else -> if(key.length==1&&key[0].isDigit()) {
+                display=when {
+                    replace||display=="无法计算" -> key
+                    display=="0" -> key
+                    display.length>=28 -> display
+                    else -> display+key
+                }
+                replace=false
+            }
+        }
+    }
+    val history=remember(historyTick,historyVisible) { CalcHistory.read(context) }
+    BoxWithConstraints(Modifier.fillMaxSize().background(scheme.background)) {
+        val compact = maxHeight < 620.dp
+        val keyHeight = if(compact) 51.dp else 65.dp
+        Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState())
+            .windowInsetsPadding(WindowInsets.safeDrawing)
+            .padding(horizontal=18.dp,vertical=12.dp),verticalArrangement=Arrangement.spacedBy(if(compact) 5.dp else 9.dp)) {
+            Row(Modifier.fillMaxWidth(),verticalAlignment=Alignment.CenterVertically,
+                horizontalArrangement=Arrangement.SpaceBetween) {
+                Text("计算器",fontSize=26.sp,fontWeight=FontWeight.SemiBold,color=scheme.onSurface)
+                Row(horizontalArrangement=Arrangement.spacedBy(2.dp)) {
+                    TextButton(onClick={science=!science}) {Text(if(science) "标准" else "科学",color=scheme.primary)}
+                    TextButton(onClick={historyVisible=true}) {Text("记录",color=scheme.primary)}
+                }
+            }
+            Spacer(Modifier.height(if(compact) 12.dp else 60.dp))
+            Text(expression,modifier=Modifier.fillMaxWidth().padding(end=8.dp),fontSize=16.sp,
+                textAlign=TextAlign.End,color=scheme.onSurfaceVariant,maxLines=1)
+            Text(display,modifier=Modifier.fillMaxWidth().padding(end=8.dp,bottom=12.dp),
+                fontSize=if(display.length>17) 27.sp else if(display.length>11) 37.sp else 53.sp,
+                color=scheme.onSurface,textAlign=TextAlign.End,maxLines=1)
+            HorizontalDivider(color=scheme.outlineVariant)
+            if(science) {
+                listOf(listOf("sin","cos","tan","√"),listOf("x²","1/x","π","⌫")).forEach { row ->
+                    Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.spacedBy(7.dp)) {
+                        row.forEach { key ->
+                            Surface(modifier=Modifier.weight(1f).height(42.dp)
+                                .combinedClickable(onClick={if(key=="⌫")tap(key) else applyScience(key)}),
+                                color=scheme.surfaceContainer,shape=RoundedCornerShape(17.dp)) {
+                                Box(contentAlignment=Alignment.Center){Text(key,color=scheme.primary,fontSize=15.sp)}
+                            }
+                        }
+                    }
+                }
+            }
+            val pad=listOf(listOf("AC","⌫","%","÷"),listOf("7","8","9","×"),
+                listOf("4","5","6","−"),listOf("1","2","3","+"),listOf("±","0",".","="))
+            pad.forEach { row ->
+                Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.spacedBy(9.dp)) {
+                    row.forEach { key ->
+                        val isOp=key in listOf("+","−","×","÷","=")
+                        val color=when {
+                            key=="="->scheme.primary
+                            isOp->scheme.primary.copy(alpha=.12f)
+                            key in listOf("AC","⌫","%","±")->scheme.surfaceContainer
+                            else->scheme.surface
+                        }
+                        val fg=if(key=="=") Color.White else if(isOp)scheme.primary else scheme.onSurface
+                        Surface(modifier=Modifier.weight(1f).height(keyHeight)
+                            .combinedClickable(onClick={tap(key)},onLongClick={
+                                if(key=="="&&mode==MokDisguise.UNLOCK_LONG && pending==null &&
+                                    operand==null && display.matches(Regex("[0-9]{6}"))) onUnlock(display)
+                            }),color=color,shape=RoundedCornerShape(26.dp)) {
+                            Box(contentAlignment=Alignment.Center) {
+                                Text(key,fontSize=if(key=="AC")19.sp else 27.sp,
+                                    color=fg,fontWeight=if(key=="=")FontWeight.Bold else FontWeight.Normal)
+                            }
+                        }
+                    }
+                }
+            }
+            Spacer(Modifier.height(8.dp))
+        }
+    }
+    if(historyVisible) AlertDialog(onDismissRequest={historyVisible=false},title={Text("计算记录")},
+        text={Column(Modifier.heightIn(max=400.dp).verticalScroll(rememberScrollState())) {
+            if(history.isEmpty()) Text("还没有计算记录",color=scheme.onSurfaceVariant)
+            history.forEach { (exp,result) ->
+                TextButton(onClick={display=result;expression=exp;historyVisible=false;replace=true},
+                    modifier=Modifier.fillMaxWidth()) {
+                    Column(Modifier.fillMaxWidth()) {
+                        Text(exp,fontSize=12.sp,color=scheme.onSurfaceVariant)
+                        Text(result,fontSize=17.sp,textAlign=TextAlign.End,modifier=Modifier.fillMaxWidth())
+                    }
+                }
+                HorizontalDivider(color=scheme.outlineVariant)
+            }
+        }},confirmButton={TextButton(onClick={historyVisible=false}){Text("关闭")}},
+        dismissButton={TextButton(onClick={CalcHistory.clear(context);historyTick++}){Text("清空记录")}})
+}
