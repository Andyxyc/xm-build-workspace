+internal data class AgendaItem(
+    val id:String, val date:String, val title:String, val time:String,
+    val note:String="", val repeat:String="none", val reminder:Int=-1,
+    val system:Boolean=false
+)
+
+/** Private local calendar data: old R6 dates survive R7 upgrades. */
+internal object MokAgendaStore {
+    private const val PREF="moksu.local.calendar.v1"
+    private const val KEY="entries"
+    private val formats=setOf("none","daily","weekly","monthly","yearly")
+    fun load(context:Context):List<AgendaItem> = runCatching {
+        val json=JSONArray(context.getSharedPreferences(PREF,Context.MODE_PRIVATE).getString(KEY,"[]")?:"[]")
+        (0 until minOf(600,json.length())).mapNotNull { index->
+            val o=json.optJSONObject(index)?:return@mapNotNull null
+            val date=o.optString("date")
+            val name=o.optString("title").take(100)
+            if(name.isBlank() || runCatching { LocalDate.parse(date) }.isFailure) return@mapNotNull null
+            val repeat=o.optString("repeat").takeIf { it in formats }?:"none"
+            val time=o.optString("time").takeIf { validTime(it) }.orEmpty()
+            AgendaItem(o.optString("id").ifEmpty { UUID.randomUUID().toString() },date,name,time,
+                o.optString("note").take(300),repeat,o.optInt("reminder",-1).coerceIn(-1,10080))
+        }
+    }.getOrDefault(emptyList())
+    private fun validTime(value:String):Boolean=value.isBlank() ||
+        (runCatching { LocalTime.parse(value) }.isSuccess)
+    fun events(context:Context,date:LocalDate):List<AgendaItem> =
+        load(context).filter{ occursOn(it,date) }.sortedWith(compareBy({it.time.isBlank()},{it.time}))
+    fun occursOn(e:AgendaItem,date:LocalDate):Boolean {
+        val start=runCatching { LocalDate.parse(e.date) }.getOrNull()?:return false
+        if(date.isBefore(start))return false
+        return when(e.repeat) {
+            "daily"->true
+            "weekly"->ChronoUnit.DAYS.between(start,date)%7L==0L
+            "monthly"->start.dayOfMonth==date.dayOfMonth
+            "yearly"->start.monthValue==date.monthValue && start.dayOfMonth==date.dayOfMonth
+            else->date==start
+        }
+    }
+    private fun write(context:Context, list:List<AgendaItem>):Boolean {
+        val arr=JSONArray()
+        list.take(600).forEach { e ->
+            arr.put(JSONObject().put("id",e.id).put("date",e.date)
+                .put("title",e.title).put("time",e.time).put("note",e.note)
+                .put("repeat",e.repeat).put("reminder",e.reminder))
+        }
+        return context.getSharedPreferences(PREF,Context.MODE_PRIVATE)
+            .edit().putString(KEY,arr.toString()).commit()
+    }
+    fun save(context:Context,item:AgendaItem):Boolean {
+        if(item.title.isBlank()||item.title.length>100||item.note.length>300||!validTime(item.time)
+            ||runCatching{LocalDate.parse(item.date)}.isFailure||item.repeat !in formats) return false
+        val list=load(context).toMutableList()
+        val index=list.indexOfFirst {it.id==item.id}
+        if(index==-1) {if(list.size>=600)return false;list.add(item)}
+        else list[index]=item
+        if(!write(context,list))return false
+        MokAgendaAlarm.schedule(context,item)
+        return true
+    }
+    fun delete(context:Context,id:String):Boolean {
+        val list=load(context)
+        if(list.none{it.id==id})return false
+        if(!write(context,list.filterNot{it.id==id}))return false
+        MokAgendaAlarm.cancel(context,id)
+        return true
+    }
+    fun byId(context:Context,id:String)=load(context).firstOrNull{it.id==id}
+}
+
+/** Inexact alarm reminders: respects normal Android notification permissions and battery limits. */
+internal object MokAgendaAlarm {
+    const val ACTION="me.weishu.kernelsu.mok.ACTION_AGENDA_REMINDER"
+    private const val CHANNEL="moksu_local_agenda"
+    private fun intent(context:Context,id:String):PendingIntent = PendingIntent.getBroadcast(context,
+        id.hashCode(),Intent(context,MokAgendaAlarmReceiver::class.java).setAction(ACTION).putExtra("event",id),
+        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+    fun cancel(context:Context,id:String) {
+        val alarm=context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        alarm.cancel(intent(context,id))
+    }
+    fun schedule(context:Context,e:AgendaItem,afterMillis:Long=System.currentTimeMillis()) {
+        cancel(context,e.id)
+        if(e.reminder<0 || e.time.isBlank())return
+        val start=runCatching{LocalDate.parse(e.date)}.getOrNull()?:return
+        val time=runCatching{LocalTime.parse(e.time)}.getOrNull()?:return
+        val zone=ZoneId.systemDefault()
+        var date=start
+        // Bounded forward scan; supports recurring dates including leap-year changes.
+        for(i in 0..1850) {
+            val occurs=MokAgendaStore.occursOn(e,date)
+            if(occurs) {
+                val at=LocalDateTime.of(date,time).atZone(zone).toInstant().toEpochMilli()-e.reminder*60_000L
+                if(at>afterMillis+1500L) {
+                    val alarm=context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+                    alarm.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP,at,intent(context,e.id))
+                    return
+                }
+            }
+            date=date.plusDays(1)
+        }
+    }
+    fun reschedule(context:Context) {MokAgendaStore.load(context).forEach{schedule(context,it)}}
+    fun show(context:Context,e:AgendaItem) {
+        if(Build.VERSION.SDK_INT>=33 && context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)
+            !=PackageManager.PERMISSION_GRANTED)return
+        val manager=context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        manager.createNotificationChannel(NotificationChannel(CHANNEL,"日程提醒",NotificationManager.IMPORTANCE_DEFAULT))
+        val open=PendingIntent.getActivity(context,e.id.hashCode(),
+            Intent(context,MokDisguiseActivity::class.java)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+        val notification=NotificationCompat.Builder(context,CHANNEL)
+            .setSmallIcon(me.weishu.kernelsu.R.mipmap.ic_launcher)
+            .setContentIntent(open)
+            .setContentTitle(e.title).setContentText(e.note.ifBlank{"${e.time} · 日程提醒"})
+            .setAutoCancel(true).setPriority(NotificationCompat.PRIORITY_DEFAULT).build()
+        manager.notify(e.id.hashCode(),notification)
+    }
+}
+
+/** Not exported: alarms and reboot may be delivered only by the OS for our own events. */
+class MokAgendaAlarmReceiver:BroadcastReceiver() {
+    override fun onReceive(context:Context,intent:Intent) {
+        when(intent.action) {
+            MokAgendaAlarm.ACTION -> {
+                val id=intent.getStringExtra("event")?:return
+                val e=MokAgendaStore.byId(context,id)?:return
+                MokAgendaAlarm.show(context,e)
+                if(e.repeat!="none") MokAgendaAlarm.schedule(context,e,System.currentTimeMillis()+3_000)
+            }
+            Intent.ACTION_BOOT_COMPLETED,Intent.ACTION_MY_PACKAGE_REPLACED ->
+                MokAgendaAlarm.reschedule(context)
+        }
+    }
+}
+
+/** Read-only import from Android's CalendarProvider, requested by a visible user action. */
+internal object MokSystemCalendar {
+    fun readMonth(context:Context,month:java.time.YearMonth):List<AgendaItem> {
+        if(context.checkSelfPermission(Manifest.permission.READ_CALENDAR)!=PackageManager.PERMISSION_GRANTED)
+            return emptyList()
+        return runCatching {
+            val start=month.atDay(1).atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli()
+            val end=month.plusMonths(1).atDay(1).atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli()
+            val uri=CalendarContract.Instances.CONTENT_URI.buildUpon()
+                .appendPath(start.toString()).appendPath(end.toString()).build()
+            val out=mutableListOf<AgendaItem>()
+            val projection=arrayOf(CalendarContract.Instances.EVENT_ID,CalendarContract.Instances.TITLE,
+                CalendarContract.Instances.BEGIN,CalendarContract.Instances.ALL_DAY)
+            context.contentResolver.query(uri,projection,null,null,CalendarContract.Instances.BEGIN+" ASC")?.use { cursor ->
+                var count=0
+                while(cursor.moveToNext() && count<200) {
+                    count++
+                    val id=cursor.getLong(0)
+                    val title=cursor.getString(1).orEmpty().take(100)
+                    val millis=cursor.getLong(2)
+                    val allDay=cursor.getInt(3)!=0
+                    val whenLocal=java.time.Instant.ofEpochMilli(millis).atZone(ZoneId.systemDefault())
+                    val civilDate=if(allDay) java.time.Instant.ofEpochMilli(millis)
+                        .atZone(java.time.ZoneOffset.UTC).toLocalDate()
+                        else whenLocal.toLocalDate()
+                    if(title.isNotBlank()) out.add(AgendaItem("system-$id-$millis",civilDate.toString(),
+                        title,if(allDay)"" else whenLocal.toLocalTime().withSecond(0).withNano(0).toString(),
+                        system=true))
+                }
+            }
+            out
+        }.getOrDefault(emptyList())
+    }
+}
